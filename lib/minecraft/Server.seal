package minecraft;

import sealnix.*;
import seal.util.List;

// Minecraft servers on NixOS, for a seal-nix configuration: each a systemd service, minecraft-<name>,
// with its loader, and its mods or plugins from Modrinth. With seal-nix-libs's module in the system,
// a configuration imports the package; then each server is a Server, whose methods give its settings
// and return it, and whose install() makes it so:
//
//     import minecraft.*;
//
//     new Server("smp")
//         .loader(Loaders.FABRIC)
//         .minecraftVersion("26.3")                 // Mojang's version, or "latest"
//         .acceptEula()                             // Mojang's EULA: https://aka.ms/MinecraftEULA
//         .memory("4G")
//         .mod("fabric-api")                        // a Modrinth project, by its slug or ID
//         .mod("lithium", "mc26.3-0.26.3-fabric")   // one version of it, by version number or ID
//         .property("motd", "A Seal server")        // server.properties
//         .install();
//
// The loaders: VANILLA, FABRIC, FORGE and NEOFORGE (mods), PAPER (plugins), VELOCITY (a proxy, with
// its plugins). install() checks the settings first, and stops the build with what is wrong.
//
// A Velocity proxy forwards players to the servers it is given, and tells them who each player is,
// as forwarding() says: MODERN, Velocity's own, unless it says otherwise. A Server given to the proxy
// is set up behind it: it listens on 127.0.0.1 alone, out of the firewall, with online-mode off (the
// proxy signs players in), and takes the proxy's forwarding: Paper by itself, Fabric with
// FabricProxy-Lite, which joins its mods with the Fabric API it needs. The proxy's install() installs
// it. A server elsewhere is given by its address, and set up by hand.
//
//     var lobby = new Server("lobby").loader(Loaders.PAPER).minecraftVersion("26.3").acceptEula().port(25566);
//     var smp = new Server("smp").loader(Loaders.FABRIC).minecraftVersion("26.3").acceptEula().port(25567);
//
//     new Server("proxy")
//         .loader(Loaders.VELOCITY)
//         .port(25565)
//         .server(lobby)                            // a player joins the first that is up
//         .server(smp)
//         .server("creative", "10.0.0.5:25565")    // set up by hand, to take modern forwarding
//         .forcedHost("smp.example.com", "smp")    // who connects by this name joins smp
//         .plugin("luckperms")
//         .install();                               // the proxy, lobby and smp
//
// Modern and BungeeGuard forwarding are signed with a secret: forwarding.secret in the proxy's folder,
// made at its first start, unless forwardingSecretFile() names one (as sops-nix or agenix give). The
// servers behind the proxy read it each time they start, so it is never in the Nix store; Paper keeps
// it in its config/paper-global.yml, so their folders are the user minecraft's alone.
//
// seal-nix runs Seal while Nix builds, which has no network, so the server downloads on the machine,
// when its service starts (preStart): the loader, then each mod or plugin, each checked against the
// hash its source gives (Mojang's sha1, PaperMC's sha256, Modrinth's sha512, Forge's and NeoForge's
// Maven sha1). What a start chose is kept in .seal-mc/, so the next one downloads nothing unless the
// configuration changed, or autoUpdate() asks for the newest at every start; a new loader or Minecraft
// version chooses every mod and plugin again. Mods and plugins this put there, which the configuration
// no longer names, are removed; ones put there by hand are kept.
//
// docs/minecraft, in seal-nix-libs, is all of it: every setting, the proxy, the service, the errors.
//
// A server lives in /var/lib/minecraft/<name>, runs as the user minecraft, and saves and stops on
// systemctl stop. nixos-rebuild switch restarts a server whose configuration changed. The first start
// of a Forge or NeoForge server runs its installer, which takes a few minutes.
class Server {
    // The names of the servers installed: each is a service and a folder of its own.
    static List<string> installed = new List();

    // A mod or plugin from Modrinth: its project, by slug or ID, and its version, by version number or
    // version ID, empty for the newest.
    record Project(string name, string version) {
        // As the start reads it: slug, or slug@version.
        string spec() { return version.length() == 0 ? name : name + "@" + version; }
    }

    // The settings, which the methods of their names give: each field is named apart from its method,
    // which Seal asks.
    string name;
    Loaders loaderType = Loaders.VANILLA;
    bit loaderGiven = false;
    string minecraft = "";                   // "26.3", "1.21.1", or "latest" (the newest when first installed)
    string loaderRelease = "";               // the loader's own version; empty for the newest
    int portNumber = 0;
    bit portGiven = false;                   // else 25565, a proxy's 25577
    string heap = "2G";
    List<string> jvmArgs = new List();
    bit eula = false;
    bit firewall = true;
    bit updates = false;
    List<Project> mods = new List();
    List<Project> plugins = new List();
    Pkg customJdk = null;                    // null for the one the Minecraft version needs
    List<string> propertyKeys = new List();
    List<string> propertyValues = new List();

    // A proxy's: its forwarding, and the servers it forwards to.
    Forwarding forwardingMode = Forwarding.MODERN;
    string secretFile = "";                  // empty for forwarding.secret in its folder
    List<string> serverNames = new List();
    List<string> serverAddresses = new List();   // empty for one given as a Server, at 127.0.0.1
    List<Server> behind = new List();        // the servers given as Servers
    List<string> tryNames = new List();
    List<string> hostNames = new List();
    List<string> hostServers = new List();
    string proxyOption = "";                 // the first of these given, to say so if this is no proxy

    Server proxy = null;                     // the proxy this is behind, once given to one

    // A server, by its name: letters, digits, - and _. Its service is minecraft-<name>, and its folder
    // /var/lib/minecraft/<name>.
    public new(string name) {
        this.name = name;
    }

    // Its loader: Loaders.VANILLA (Mojang's server), FABRIC, FORGE or NEOFORGE (mods), PAPER (plugins),
    // or VELOCITY (a proxy).
    public Server loader(Loaders loader) {
        loaderType = loader;
        loaderGiven = true;
        return this;
    }

    // Its Minecraft version: Mojang's, "26.3", "1.21.1", or "latest", the newest at the first start. A
    // proxy takes none.
    public Server minecraftVersion(string version) {
        minecraft = version;
        return this;
    }

    // Fabric's loader, Forge's or NeoForge's version, Paper's build, Velocity's version; the newest
    // unless given (Forge's recommended, if it has one).
    public Server loaderVersion(string version) {
        loaderRelease = version;
        return this;
    }

    // 25565 unless given; a proxy's, 25577.
    public Server port(int port) {
        portNumber = port;
        portGiven = true;
        return this;
    }

    // The Java heap, -Xms and -Xmx: "4G", "512M"; 2G unless given.
    public Server memory(string size) {
        heap = size;
        return this;
    }

    // An argument for java, before the server's own: jvmArg("-XX:+UseZGC").
    public Server jvmArg(string arg) {
        jvmArgs.add(arg);
        return this;
    }

    // Mojang's EULA, https://aka.ms/MinecraftEULA: without it, no server starts. A proxy needs none.
    public Server acceptEula() {
        eula = true;
        return this;
    }

    // The port, in networking.firewall.allowedTCPPorts unless openFirewall(false). A server behind a
    // proxy, which only the proxy reaches, never is.
    public Server openFirewall(bit open) {
        firewall = open;
        return this;
    }

    // The newest loader, mods and plugins at every start, not only the first.
    public Server autoUpdate() {
        updates = true;
        return this;
    }

    // Fabric, Forge, NeoForge: a mod, a Modrinth project by its slug or ID, in its newest version for
    // the server's loader and Minecraft version.
    public Server mod(string project) {
        return mod(project, "");
    }

    // That version of it: its version number as Modrinth has it, whole ("mc26.3-0.26.3-fabric"), or
    // its version ID.
    public Server mod(string project, string version) {
        mods.add(new Project(project, version));
        return this;
    }

    // Paper, Velocity: a plugin, as a mod is: plugin("luckperms"), plugin("luckperms", "v5.5.71-bukkit").
    public Server plugin(string project) {
        return plugin(project, "");
    }

    public Server plugin(string project, string version) {
        plugins.add(new Project(project, version));
        return this;
    }

    // A line of server.properties, set at every start: property("max-players", "20").
    public Server property(string key, string value) {
        int at = propertyKeys.indexOf(key);
        if (at >= 0) {
            propertyValues.set(at, value);
        } else {
            propertyKeys.add(key);
            propertyValues.add(value);
        }
        return this;
    }

    // The Java to run; the one the Minecraft version needs unless given.
    public Server jdk(Pkg jdk) {
        customJdk = jdk;
        return this;
    }

    // A proxy's forwarding: MODERN unless given.
    public Server forwarding(Forwarding mode) {
        forwardingMode = mode;
        return proxyOnly("forwarding");
    }

    // A proxy's forwarding secret: a file it and its servers can read, as the user minecraft, such as
    // "/run/secrets/velocity". Unless given, forwarding.secret in the proxy's folder, made at its
    // first start.
    public Server forwardingSecretFile(string path) {
        secretFile = path;
        return proxyOnly("forwardingSecretFile");
    }

    // A server the proxy forwards to, by its address, "host:port": one set up by hand to take the
    // proxy's forwarding.
    public Server server(string name, string address) {
        serverNames.add(name);
        serverAddresses.add(address);
        return proxyOnly("server");
    }

    // A server the proxy forwards to, configured here: it is set up behind the proxy, and the proxy's
    // install() installs it.
    public Server server(Server other) {
        if (other.proxy != null && other.proxy != this) {
            throw new IllegalStateException("Minecraft server " + name + ": " + other.name + " is behind the proxy "
                + other.proxy.name + " already: a server is behind one proxy");
        }
        serverNames.add(other.name);
        serverAddresses.add("");
        behind.add(other);
        other.proxy = this;
        return proxyOnly("server");
    }

    // Velocity's try list: where a player joins, the first of these that is up, and where one goes
    // when a server stops under them. Unless given, every server, in the order given.
    public Server tryServer(string name) {
        tryNames.add(name);
        return proxyOnly("tryServer");
    }

    // A forced host: who connects by this hostname joins this server, not the try list's. Given again
    // for the same hostname, the next to try.
    public Server forcedHost(string hostname, string server) {
        hostNames.add(hostname);
        hostServers.add(server);
        return proxyOnly("forcedHost");
    }

    Server proxyOnly(string option) {
        if (proxyOption.length() == 0) { proxyOption = option; }
        return this;
    }

    // The service, its user, and the port; a proxy's with the servers behind it. The settings are
    // checked first.
    public void install() {
        if (proxy != null) {
            throw new IllegalStateException("Minecraft server " + name + " is behind the proxy " + proxy.name
                + ", whose install() installs it: leave out " + name + "'s own");
        }
        check();
        installService();
        for (Server b : behind) { b.installService(); }
    }

    // The port it listens on: the one given, or its loader's.
    int listenPort() {
        if (portGiven) { return portNumber; }
        return loaderType == Loaders.VELOCITY ? 25577 : 25565;
    }

    // The Minecraft version, as the start reads it; a proxy has none, and its Velocity is the newest.
    string mcVersion() {
        return loaderType == Loaders.VELOCITY ? "latest" : minecraft;
    }

    void installService() {
        if (installed.contains(name)) {
            throw new IllegalStateException("Minecraft server " + name + " is installed twice: install each server "
                + "once, each with a name of its own");
        }
        installed.add(name);
        string unit = "minecraft-" + name;

        Config.users.users.minecraft.isSystemUser = true;
        Config.users.users.minecraft.group = "minecraft";
        Config.users.users.minecraft.home = "/var/lib/minecraft";
        Config.users.groups.get("minecraft");

        Config.systemd.services.get(unit).description = "Minecraft server " + name + " (" + describe() + ")"
            + (proxy != null ? ", behind " + proxy.name : "");
        Config.systemd.services.get(unit).wantedBy.add("multi-user.target");
        Config.systemd.services.get(unit).after.add("network-online.target");
        Config.systemd.services.get(unit).wants.add("network-online.target");
        if (proxy != null) {
            // the proxy first, which makes the forwarding secret this reads
            Config.systemd.services.get(unit).after.add("minecraft-" + proxy.name + ".service");
            Config.systemd.services.get(unit).wants.add("minecraft-" + proxy.name + ".service");
        }
        Config.systemd.services.get(unit).preStart = prepareScript();
        Config.systemd.services.get(unit).script = startScript();
        Config.systemd.services.get(unit).serviceConfig.set("User", "minecraft");
        Config.systemd.services.get(unit).serviceConfig.set("Group", "minecraft");
        Config.systemd.services.get(unit).serviceConfig.set("StateDirectory", "minecraft/" + name);
        if (proxy != null) {
            // the proxy's secret, which Paper writes into its config, is no one else's to read
            Config.systemd.services.get(unit).serviceConfig.set("StateDirectoryMode", "0750");
        }
        Config.systemd.services.get(unit).serviceConfig.set("WorkingDirectory", "/var/lib/minecraft/" + name);
        Config.systemd.services.get(unit).serviceConfig.set("Restart", "on-failure");
        Config.systemd.services.get(unit).serviceConfig.set("RestartSec", 10);
        Config.systemd.services.get(unit).serviceConfig.set("TimeoutStartSec", "20min");       // the first start downloads, and installs Forge
        Config.systemd.services.get(unit).serviceConfig.set("TimeoutStopSec", 120);            // time to save the worlds
        Config.systemd.services.get(unit).serviceConfig.set("SuccessExitStatus", "0 143");     // 143: stopped by SIGTERM, having saved
        Config.systemd.services.get(unit).serviceConfig.set("PrivateTmp", true);
        Config.systemd.services.get(unit).serviceConfig.set("NoNewPrivileges", true);
        Config.systemd.services.get(unit).serviceConfig.set("ProtectSystem", "strict");
        Config.systemd.services.get(unit).serviceConfig.set("ProtectHome", true);
        Config.setRaw("systemd.services." + unit + ".path", "[ " + tools() + " ]");

        if (firewall && proxy == null) { Config.networking.firewall.allowedTCPPorts.add(listenPort()); }
    }

    void check() {
        string about = "Minecraft server " + name + ": ";
        if (!plain(name, "-_") || name.length() == 0) {
            throw new IllegalArgumentException("Minecraft server \"" + name + "\": a name is letters, digits, - and _");
        }
        if (!loaderGiven) {
            throw new IllegalArgumentException(about + "no loader: loader(Loaders.FABRIC), say, or Loaders.VANILLA, "
                + "FORGE, NEOFORGE, PAPER, or VELOCITY for a proxy");
        }
        if (loaderType == Loaders.VELOCITY) {
            if (minecraft.length() > 0) {
                throw new IllegalArgumentException(about + "a proxy takes no Minecraft version; its Velocity's own "
                    + "version is loaderVersion()'s");
            }
        } else if (minecraft.length() == 0) {
            throw new IllegalArgumentException(about + "no Minecraft version: minecraftVersion(\"26.3\"), say, or "
                + "minecraftVersion(\"latest\")");
        } else if (!plain(minecraft, ".-_+")) {
            throw new IllegalArgumentException(about + "no Minecraft version \"" + minecraft + "\"");
        }
        if (!plain(loaderRelease, ".-_+")) {
            throw new IllegalArgumentException(about + "no loader version \"" + loaderRelease + "\"");
        }
        if (!plain(heap, "") || heap.length() == 0) {
            throw new IllegalArgumentException(about + "memory is a size, as \"4G\" or \"512M\"");
        }
        if (portGiven && (portNumber < 1 || portNumber > 65535)) {
            throw new IllegalArgumentException(about + "no port " + portNumber);
        }
        if (loaderType != Loaders.VELOCITY && !eula) {
            throw new IllegalStateException(about + "a server runs only once its owner accepts "
                + "Mojang's EULA (https://aka.ms/MinecraftEULA): acceptEula()");
        }
        bit modded = loaderType == Loaders.FABRIC || loaderType == Loaders.FORGE || loaderType == Loaders.NEOFORGE;
        bit plugged = loaderType == Loaders.PAPER || loaderType == Loaders.VELOCITY;
        if (!mods.isEmpty() && !modded) {
            throw new IllegalArgumentException(about + describe() + " takes no mods; Fabric, Forge and NeoForge do");
        }
        if (!plugins.isEmpty() && !plugged) {
            throw new IllegalArgumentException(about + describe() + " takes no plugins; Paper and Velocity do");
        }
        if (loaderType == Loaders.VELOCITY && !propertyKeys.isEmpty()) {
            throw new IllegalArgumentException(about + describe() + " has no server.properties; "
                + "a proxy's own settings are its velocity.toml's");
        }
        for (Project m : mods) { checkProject(m, "mod"); }
        for (Project p : plugins) { checkProject(p, "plugin"); }
        for (int k = 0; k < propertyKeys.size(); k++) {
            if (!plain(propertyKeys.get(k), ".-_") || propertyValues.get(k).contains("\n")) {
                throw new IllegalArgumentException(about + "no property " + propertyKeys.get(k));
            }
        }
        if (loaderType == Loaders.VELOCITY) {
            checkProxy();
        } else if (proxyOption.length() > 0) {
            throw new IllegalArgumentException(about + proxyOption + "() is a Velocity proxy's, and "
                + describe() + " is no proxy");
        }
    }

    void checkProject(Project p, string kind) {
        string about = "Minecraft server " + name + ": ";
        int at = p.name.indexOf('@');
        if (at > 0) {
            throw new IllegalArgumentException(about + "no Modrinth project \"" + p.name + "\": a version is "
                + kind + "'s second argument, " + kind + "(\"" + p.name.substring(0, at) + "\", \""
                + p.name.substring(at + 1, p.name.length()) + "\")");
        }
        if (p.name.length() == 0 || !plain(p.name, ".-_+")) {
            throw new IllegalArgumentException(about + "no Modrinth project \"" + p.name + "\"");
        }
        if (p.version.contains("\t") || p.version.contains("\n")) {
            throw new IllegalArgumentException(about + "no version \"" + p.version + "\" of " + p.name);
        }
    }

    // The address of the proxy's server k: the one given, or, for a Server, 127.0.0.1 and its port.
    string addressOf(int k) {
        string a = serverAddresses.get(k);
        if (a.length() > 0) { return a; }
        for (Server b : behind) {
            if (b.name == serverNames.get(k)) { return "127.0.0.1:" + b.listenPort(); }
        }
        return a;
    }

    void checkProxy() {
        string about = "Minecraft server " + name + ": ";
        if (secretFile.length() > 0 && (!secretFile.startsWith("/") || !plain(secretFile, "/._-+@"))) {
            throw new IllegalArgumentException(about + "the forwarding secret file is a path, as \"/run/secrets/velocity\", "
                + "not \"" + secretFile + "\"");
        }
        for (int k = 0; k < serverNames.size(); k++) {
            string s = serverNames.get(k);
            string address = addressOf(k);
            if (s.length() == 0 || !plain(s, "-_") || s == "try") {
                throw new IllegalArgumentException(about + "no server name \"" + s + "\": a name is letters, digits, - and _, "
                    + "and not try");
            }
            if (serverNames.indexOf(s) != k) {
                throw new IllegalArgumentException(about + "two servers are named " + s);
            }
            if (address.length() == 0 || !plain(address, ".-_:[]")) {
                throw new IllegalArgumentException(about + "no address \"" + address + "\" for the server " + s
                    + ": an address is host:port, as \"10.0.0.5:25565\"");
            }
        }
        for (string t : tryNames) {
            if (!serverNames.contains(t)) {
                throw new IllegalArgumentException(about + "tryServer(\"" + t + "\") names no server; server() gives them");
            }
        }
        for (int k = 0; k < hostNames.size(); k++) {
            string host = hostNames.get(k);
            if (host.length() == 0 || !plain(host, ".-_")) {
                throw new IllegalArgumentException(about + "no hostname \"" + host + "\" for a forced host");
            }
            if (!serverNames.contains(hostServers.get(k))) {
                throw new IllegalArgumentException(about + "forcedHost(\"" + host + "\", \"" + hostServers.get(k)
                    + "\") names no server; server() gives them");
            }
        }
        for (int k = 0; k < behind.size(); k++) {
            Server b = behind.get(k);
            string them = about + b.name;
            b.check();
            if (b.loaderType == Loaders.VELOCITY) {
                throw new IllegalArgumentException(them + " is a proxy itself");
            }
            if (b.name == name) {
                throw new IllegalArgumentException(them + " has the proxy's own name");
            }
            if (installed.contains(b.name)) {
                throw new IllegalStateException(them + " is installed on its own already: the proxy's install() installs "
                    + "it, so leave out its own");
            }
            if (b.listenPort() == listenPort()) {
                throw new IllegalArgumentException(them + " and the proxy both have port " + listenPort() + "; give one another");
            }
            for (int j = 0; j < k; j++) {
                if (behind.get(j).listenPort() == b.listenPort()) {
                    throw new IllegalArgumentException(them + " and " + behind.get(j).name + " both have port " + b.listenPort()
                        + "; give one another");
                }
            }
            b.checkBehind(this);
        }
    }

    // Whether this takes the proxy's forwarding as this file sets it up: any server takes NONE, Paper
    // MODERN and LEGACY, Fabric MODERN.
    void checkBehind(Server front) {
        Forwarding f = front.forwardingMode;
        bit paper = loaderType == Loaders.PAPER && (f == Forwarding.MODERN || f == Forwarding.LEGACY);
        bit fabric = loaderType == Loaders.FABRIC && f == Forwarding.MODERN;
        if (f != Forwarding.NONE && !paper && !fabric) {
            throw new IllegalArgumentException("Minecraft server " + front.name + ": " + name + " (" + describe() + ") can't "
                + "take " + f.name() + " forwarding as this sets it up (Paper takes MODERN or LEGACY, Fabric MODERN): give "
                + "the proxy forwarding(Forwarding.NONE), or set up " + name + " by hand and give the proxy its address");
        }
        if (loaderType == Loaders.PAPER && minecraft.startsWith("1.") && number(minecraft, 1) < 19) {
            throw new IllegalArgumentException("Minecraft server " + front.name + ": " + name + " is Paper " + minecraft
                + "; behind a proxy, Paper is 1.19 or newer, whose config/paper-global.yml this sets");
        }
    }

    string describe() {
        string version = loaderType == Loaders.VELOCITY ? loaderRelease : minecraft;
        return loaderId() + (version.length() > 0 ? " " + version : "");
    }

    string loaderId() {
        return switch (loaderType) {
            case VANILLA -> "vanilla";
            case FABRIC -> "fabric";
            case FORGE -> "forge";
            case NEOFORGE -> "neoforge";
            case PAPER -> "paper";
            case VELOCITY -> "velocity";
        };
    }

    // The Java the Minecraft version needs: 25 from 26.1, 21 from 1.20.5, 17 from 1.17, else 8;
    // Velocity 4 needs 25.
    Pkg java() {
        if (customJdk != null) { return customJdk; }
        if (loaderType == Loaders.VELOCITY) { return Packages.jdk25_headless; }
        if (!minecraft.startsWith("1.")) { return Packages.jdk25_headless; }
        int minor = number(minecraft, 1);
        int patch = number(minecraft, 2);
        if (minor > 20 || (minor == 20 && patch >= 5)) { return Packages.jdk21_headless; }
        if (minor >= 17) { return Packages.jdk17_headless; }
        return Packages.jdk8_headless;
    }

    // What preStart runs with; Paper's yq edits its YAML, Velocity's unzip takes its default velocity.toml.
    string tools() {
        string more = loaderType == Loaders.PAPER ? " " + Packages.yq_go
            : loaderType == Loaders.VELOCITY ? " " + Packages.unzip : "";
        return "" + Packages.curl + " " + Packages.jq + " " + Packages.coreutils + " " + Packages.gawk + " "
            + Packages.gnugrep + " " + java() + more;
    }

    // The forwarding secret's file: a proxy's own, or the proxy's this is behind; empty for neither.
    string secretPath() {
        if (loaderType == Loaders.VELOCITY) {
            return secretFile.length() > 0 ? secretFile : "/var/lib/minecraft/" + name + "/forwarding.secret";
        }
        return proxy != null ? proxy.secretPath() : "";
    }

    // Where a server behind a proxy finds its modern forwarding's secret as it starts: Paper's
    // PAPER_VELOCITY_SECRET, FabricProxy-Lite's FABRIC_PROXY_SECRET; empty for none.
    string secretVariable() {
        if (proxy == null || proxy.forwardingMode != Forwarding.MODERN) { return ""; }
        if (loaderType == Loaders.PAPER) { return "PAPER_VELOCITY_SECRET"; }
        if (loaderType == Loaders.FABRIC) { return "FABRIC_PROXY_SECRET"; }
        return "";
    }

    // The mods given; behind a proxy's modern forwarding, Fabric's with FabricProxy-Lite, and the
    // Fabric API it needs.
    List<Project> modList() {
        List<Project> list = copyOf(mods);
        if (loaderType == Loaders.FABRIC && proxy != null && proxy.forwardingMode == Forwarding.MODERN) {
            for (string slug : ["fabric-api", "fabricproxy-lite"]) {
                if (!names(list, slug)) { list.add(new Project(slug, "")); }
            }
        }
        return list;
    }

    // server.properties' lines: behind a proxy, offline (the proxy signs players in) on 127.0.0.1;
    // then the properties given, which come after, and so win.
    List<string> propertyLines() {
        List<string> lines = new List();
        if (proxy != null) {
            lines.add("online-mode=false");
            lines.add("server-ip=127.0.0.1");
        }
        for (int k = 0; k < propertyKeys.size(); k++) { lines.add(propertyKeys.get(k) + "=" + propertyValues.get(k)); }
        return lines;
    }

    // velocity.toml's [servers] and [forced-hosts]; empty when no server is given, so that
    // velocity.toml keeps its own.
    string serversToml() {
        if (serverNames.isEmpty()) { return ""; }
        StringBuilder b = new StringBuilder();
        b.append("[servers]\n");
        for (int k = 0; k < serverNames.size(); k++) {
            b.append(serverNames.get(k)).append(" = \"").append(addressOf(k)).append("\"\n");
        }
        b.append("try = [").append(toml(tryNames.isEmpty() ? serverNames : tryNames)).append("]\n");
        b.append("\n[forced-hosts]\n");
        List<string> hosts = new List();
        for (string h : hostNames) {
            if (!hosts.contains(h)) { hosts.add(h); }
        }
        for (string h : hosts) {
            List<string> to = new List();
            for (int k = 0; k < hostNames.size(); k++) {
                if (hostNames.get(k) == h) { to.add(hostServers.get(k)); }
            }
            b.append('"').append(h).append("\" = [").append(toml(to)).append("]\n");
        }
        return b.toString();
    }

    string prepareScript() {
        StringBuilder b = new StringBuilder();
        b.append("set -euo pipefail\n");
        b.append("LOADER=").append(loaderId()).append('\n');
        b.append("MC=").append(sh(mcVersion())).append('\n');
        b.append("LOADER_VERSION=").append(sh(loaderRelease)).append('\n');
        b.append("PORT=").append(listenPort()).append('\n');
        b.append("AUTO_UPDATE=").append(updates ? "1" : "0").append('\n');
        b.append("EULA=").append(eula ? "1" : "0").append('\n');
        b.append("MODS=(").append(words(specs(modList()))).append(")\n");
        b.append("PLUGINS=(").append(words(specs(plugins))).append(")\n");
        b.append("PROPERTIES=(").append(words(propertyLines())).append(")\n");
        b.append("BEHIND=").append(proxy != null ? proxy.forwardingMode.name() : "").append('\n');
        b.append("FORWARDING=").append(loaderType == Loaders.VELOCITY ? forwardingMode.name() : "").append('\n');
        b.append("SECRET=").append(sh(secretPath())).append('\n');
        b.append("OWN_SECRET=").append(loaderType == Loaders.VELOCITY && secretFile.length() == 0 ? "1" : "0").append('\n');
        b.append("SERVERS=").append(sh(serversToml())).append('\n');
        b.append(PREPARE);
        return b.toString();
    }

    string startScript() {
        StringBuilder b = new StringBuilder();
        b.append("set -euo pipefail\n");
        b.append("mapfile -t launch < .seal-mc/launch\n");
        string variable = secretVariable();
        if (variable.length() > 0) {
            // the proxy's secret, which the server takes from its environment, so no file of its own holds it
            b.append("SECRET=").append(sh(secretPath())).append('\n');
            b.append("if ! secret=$(cat -- \"$SECRET\") || [ -z \"$secret\" ]; then\n");
            b.append("  echo \"minecraft: no forwarding secret to read in $SECRET, which minecraft-")
                .append(proxy.name).append(" signs with\" >&2\n");
            b.append("  exit 1\n");
            b.append("fi\n");
            b.append("export ").append(variable).append("=$secret\n");
        }
        b.append("exec java -Xms").append(heap).append(" -Xmx").append(heap);
        for (string a : jvmArgs) { b.append(' ').append(sh(a)); }
        b.append(" \"${launch[@]}\"\n");
        return b.toString();
    }

    static <T> List<T> copyOf(List<T> list) {
        List<T> copy = new List();
        for (T x : list) { copy.add(x); }
        return copy;
    }

    // Whether a Modrinth project is among those given, in any version.
    static bit names(List<Project> projects, string slug) {
        for (Project p : projects) {
            if (p.name == slug) { return true; }
        }
        return false;
    }

    static List<string> specs(List<Project> projects) {
        List<string> list = new List();
        for (Project p : projects) { list.add(p.spec()); }
        return list;
    }

    // Letters, digits, and the characters given.
    static bit plain(string s, string allowed) {
        for (int k = 0; k < s.length(); k++) {
            char c = s.charAt(k);
            bit ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9');
            for (int j = 0; j < allowed.length(); j++) {
                if (c == allowed.charAt(j)) { ok = true; }
            }
            if (!ok) { return false; }
        }
        return true;
    }

    // The number at a place in a version: number("1.20.5", 2) is 5; 0 where there is none.
    static int number(string version, int place) {
        int at = 0;
        int value = 0;
        for (int k = 0; k < version.length(); k++) {
            char c = version.charAt(k);
            if (c == '.') {
                if (at == place) { return value; }
                at++;
                value = 0;
            } else if (at == place) {
                if (c < '0' || c > '9') { return value; }
                value = value * 10 + (c - '0');
            }
        }
        return at == place ? value : 0;
    }

    // A word for the shell, in single quotes.
    static string sh(string s) {
        StringBuilder b = new StringBuilder();
        b.append('\'');
        for (int k = 0; k < s.length(); k++) {
            char c = s.charAt(k);
            if (c == '\'') {
                b.append("'\"'\"'");
            } else {
                b.append(c);
            }
        }
        b.append('\'');
        return b.toString();
    }

    static string words(List<string> list) {
        StringBuilder b = new StringBuilder();
        for (string s : list) {
            if (b.length() > 0) { b.append(' '); }
            b.append(sh(s));
        }
        return b.toString();
    }

    // A TOML list of strings, without its brackets: "lobby", "smp".
    static string toml(List<string> list) {
        StringBuilder b = new StringBuilder();
        for (string s : list) {
            if (b.length() > 0) { b.append(", "); }
            b.append('"').append(s).append('"');
        }
        return b.toString();
    }

    // What preStart runs, after the server's own settings (LOADER, MC, MODS...): bash, with curl and jq.
    static string PREPARE = """
        UA='seal-nix-libs minecraft (github.com/TheLinuxSeal/seal-nix-libs)'
        MOJANG=https://piston-meta.mojang.com/mc/game/version_manifest_v2.json
        mkdir -p .seal-mc

        log() { echo "minecraft: $*" >&2; }
        fail() { log "$*"; exit 1; }
        get() { curl -fsSL --retry 3 --retry-delay 2 -A "$UA" "$@"; }

        # fetch URL FILE ALGORITHM CHECKSUM: the file, checked, put in place only when it is whole
        fetch() {
          get -o "$2.part" "$1" || fail "can't download $1"
          if [ -n "$4" ] && [ "$("$3sum" "$2.part" | cut -d ' ' -f 1)" != "$4" ]; then
            rm -f "$2.part"
            fail "$1: the download's $3 isn't $4"
          fi
          mv -f "$2.part" "$2"
        }

        # A Maven artifact's sha1, when the repository has one.
        mavensha1() { get "$1.sha1" 2>/dev/null | cut -d ' ' -f 1 || true; }

        # The loader: again only when the configuration asks for another, or for the newest each time.
        want="$LOADER $MC $LOADER_VERSION"
        if [ "$AUTO_UPDATE" = 1 ] || [ "$(cat .seal-mc/requested 2>/dev/null)" != "$want" ] || [ ! -s .seal-mc/launch ]; then
          if [ "$MC" = latest ] && [ "$LOADER" != velocity ]; then
            if [ "$LOADER" = paper ]; then
              MC=$(get https://fill.papermc.io/v3/projects/paper | jq -r '[.versions[][] | select(test("-") | not)][0]')
            else
              MC=$(get "$MOJANG" | jq -r .latest.release)
            fi
          fi
          case "$LOADER" in
          vanilla)
            url=$(get "$MOJANG" | jq -r --arg v "$MC" '.versions[] | select(.id == $v) | .url')
            [ -n "$url" ] || fail "Minecraft has no version $MC"
            server=$(get "$url" | jq -c .downloads.server)
            log "Minecraft $MC"
            fetch "$(jq -r .url <<<"$server")" server.jar sha1 "$(jq -r .sha1 <<<"$server")"
            launch=(-jar server.jar nogui)
            ;;
          fabric)
            lv=$LOADER_VERSION
            if [ -z "$lv" ]; then
              lv=$(get "https://meta.fabricmc.net/v2/versions/loader/$MC" | jq -r '[.[] | select(.loader.stable)][0].loader.version // empty')
            fi
            [ -n "$lv" ] || fail "Fabric has no loader for Minecraft $MC"
            iv=$(get https://meta.fabricmc.net/v2/versions/installer | jq -r '[.[] | select(.stable)][0].version')
            log "Fabric $lv for Minecraft $MC"
            fetch "https://meta.fabricmc.net/v2/versions/loader/$MC/$lv/$iv/server/jar" fabric-server.jar sha1 ""
            launch=(-jar fabric-server.jar nogui)
            ;;
          forge)
            fv=$LOADER_VERSION
            if [ -z "$fv" ]; then
              fv=$(get https://files.minecraftforge.net/net/minecraftforge/forge/promotions_slim.json \
                | jq -r --arg r "$MC-recommended" --arg l "$MC-latest" '.promos[$r] // .promos[$l] // empty')
            fi
            [ -n "$fv" ] || fail "Forge has no version for Minecraft $MC"
            url="https://maven.minecraftforge.net/net/minecraftforge/forge/$MC-$fv/forge-$MC-$fv-installer.jar"
            log "Forge $fv for Minecraft $MC: installing"
            fetch "$url" .seal-mc/installer.jar sha1 "$(mavensha1 "$url")"
            java -jar .seal-mc/installer.jar --installServer > .seal-mc/installer.log 2>&1 \
              || fail "Forge's installer failed; .seal-mc/installer.log says why"
            rm -f .seal-mc/installer.jar
            args="libraries/net/minecraftforge/forge/$MC-$fv/unix_args.txt"
            if [ -f "$args" ]; then
              launch=("@$args" nogui)
            else
              launch=(-jar "$(ls forge-"$MC-$fv"*.jar | grep -v installer | head -n 1)" nogui)
            fi
            ;;
          neoforge)
            nv=$LOADER_VERSION
            if [ -z "$nv" ]; then
              case "$MC" in
                1.*.*) prefix="${MC#1.}." ;;
                1.*) prefix="${MC#1.}.0." ;;
                *.*.*) prefix="$MC." ;;
                *) prefix="$MC.0." ;;
              esac
              nv=$(get https://maven.neoforged.net/api/maven/versions/releases/net/neoforged/neoforge \
                | jq -r --arg p "$prefix" '[.versions[] | select(startswith($p))] | (map(select(test("alpha|beta") | not)) | last) // last // empty')
            fi
            [ -n "$nv" ] || fail "NeoForge has no version for Minecraft $MC"
            url="https://maven.neoforged.net/releases/net/neoforged/neoforge/$nv/neoforge-$nv-installer.jar"
            log "NeoForge $nv for Minecraft $MC: installing"
            fetch "$url" .seal-mc/installer.jar sha1 "$(mavensha1 "$url")"
            java -jar .seal-mc/installer.jar --installServer > .seal-mc/installer.log 2>&1 \
              || fail "NeoForge's installer failed; .seal-mc/installer.log says why"
            rm -f .seal-mc/installer.jar
            launch=("@libraries/net/neoforged/neoforge/$nv/unix_args.txt" nogui)
            ;;
          paper | velocity)
            v=$MC
            build=${LOADER_VERSION:-latest}
            if [ "$LOADER" = velocity ]; then
              v=${LOADER_VERSION:-latest}
              build=latest
              if [ "$v" = latest ]; then
                v=$(get https://fill.papermc.io/v3/projects/velocity | jq -r '[.versions[][] | select(test("SNAPSHOT") | not)][0]')
              fi
            fi
            d=$(get "https://fill.papermc.io/v3/projects/$LOADER/versions/$v/builds/$build" | jq -c '.downloads["server:default"]') \
              || fail "PaperMC has no $LOADER $v, build $build"
            log "$(jq -r .name <<<"$d")"
            fetch "$(jq -r .url <<<"$d")" "$LOADER.jar" sha256 "$(jq -r .checksums.sha256 <<<"$d")"
            launch=(-jar "$LOADER.jar")
            if [ "$LOADER" = paper ]; then launch+=(nogui); fi
            ;;
          esac
          printf '%s\\n' "${launch[@]}" > .seal-mc/launch
          echo "$MC" > .seal-mc/minecraft
          echo "$want" > .seal-mc/requested
        fi
        MC=$(cat .seal-mc/minecraft)

        # sync DIR LOADERS GAMES SPEC...: the Modrinth projects named, in DIR. A file this put there
        # before, which no project names now, goes; LOADERS and GAMES are JSON lists, or GAMES null.
        # The files chosen are kept, unless autoUpdate, or the loader or Minecraft version they were
        # chosen for has changed: then every project is chosen again.
        sync() {
          local dir=$1 loaders=$2 games=$3
          shift 3
          mkdir -p "$dir"
          local lock=".seal-mc/$dir.lock" next=".seal-mc/$dir.lock.next" made=".seal-mc/$dir.for"
          touch "$lock"
          : > "$next"
          local again=$AUTO_UPDATE
          if [ "$(cat "$made" 2>/dev/null)" != "$LOADER $MC" ]; then again=1; fi
          local spec slug pin old query versions v file name
          for spec in "$@"; do
            slug=${spec%%@*}
            pin=
            if [ "$spec" != "$slug" ]; then pin=${spec#*@}; fi
            old=$(awk -F '\\t' -v s="$spec" '$1 == s { print $2 }' "$lock")
            if [ "$again" != 1 ] && [ -n "$old" ] && [ -f "$dir/$old" ]; then
              printf '%s\\t%s\\n' "$spec" "$old" >> "$next"
              continue
            fi
            query="loaders=$(jq -rn --argjson v "$loaders" '$v | tojson | @uri')"
            if [ "$games" != null ]; then query="$query&game_versions=$(jq -rn --argjson v "$games" '$v | tojson | @uri')"; fi
            versions=$(get "https://api.modrinth.com/v2/project/$slug/version?$query") || fail "Modrinth has no project $slug"
            v=$(jq -c --arg pin "$pin" '(if $pin != "" then map(select(.version_number == $pin or .id == $pin))
              else map(select(.version_type == "release")) + . end) | .[0] // empty' <<<"$versions")
            [ -n "$v" ] || fail "$slug has no version${pin:+ $pin} for $LOADER $MC on Modrinth"
            file=$(jq -c '(.files | map(select(.primary))) + .files | .[0]' <<<"$v")
            name=$(jq -r .filename <<<"$file")
            if [ ! -f "$dir/$name" ]; then
              log "$dir: $slug $(jq -r .version_number <<<"$v")"
              fetch "$(jq -r .url <<<"$file")" "$dir/$name" sha512 "$(jq -r .hashes.sha512 <<<"$file")"
            fi
            if [ -n "$old" ] && [ "$old" != "$name" ]; then rm -f "$dir/$old"; fi
            printf '%s\\t%s\\n' "$spec" "$name" >> "$next"
          done
          while IFS=$'\\t' read -r spec old; do
            if ! awk -F '\\t' -v f="$old" '$2 == f { found = 1 } END { exit !found }' "$next"; then
              rm -f "$dir/$old"
              log "$dir: removed $old"
            fi
          done < "$lock"
          mv -f "$next" "$lock"
          echo "$LOADER $MC" > "$made"
        }

        games=$(jq -cn --arg v "$MC" '[$v]')
        case "$LOADER" in
          fabric | forge | neoforge) sync mods "$(jq -cn --arg l "$LOADER" '[$l]')" "$games" "${MODS[@]}" ;;
          paper) sync plugins '["paper","spigot","bukkit"]' "$games" "${PLUGINS[@]}" ;;
          velocity) sync plugins '["velocity"]' null "${PLUGINS[@]}" ;;
        esac

        # The port, and what else the configuration sets. For Velocity, velocity.toml: its bind, its
        # forwarding, and, when the configuration names servers, its [servers] and [forced-hosts].
        if [ "$LOADER" = velocity ]; then
          if [ "$OWN_SECRET" = 1 ] && [ ! -s "$SECRET" ]; then
            secret=$(head -c 32 /dev/urandom | sha256sum | cut -d ' ' -f 1)
            (umask 077 && printf '%s' "$secret" > "$SECRET.part")
            mv -f "$SECRET.part" "$SECRET"
            log "a new forwarding secret, in $SECRET"
          fi
          case "$FORWARDING" in
            MODERN | BUNGEEGUARD)
              [ -r "$SECRET" ] && [ -s "$SECRET" ] || fail "$FORWARDING forwarding is signed with a secret, and $SECRET holds none" ;;
          esac
          # A new velocity.toml is Velocity's own, with its config-version: without one, Velocity takes the
          # file for an old one, and puts forwarding-secret-file back to forwarding.secret.
          if [ ! -s velocity.toml ]; then
            unzip -p velocity.jar default-velocity.toml > velocity.toml.next 2>/dev/null || true
            [ -s velocity.toml.next ] || echo 'config-version = "2.0"' > velocity.toml.next
            mv -f velocity.toml.next velocity.toml
          fi
          TOP=$(printf '%s\\n' "bind = '0.0.0.0:$PORT'" "player-info-forwarding-mode = '$FORWARDING'" \
            "forwarding-secret-file = '$SECRET'")
          # TOP's keys, each in place of the one there, or else before the first table; TABLES, when there
          # are any, in place of [servers] and [forced-hosts], keeping the comments of the table after them.
          TOP=$TOP TABLES=$SERVERS awk '
            BEGIN {
              n = split(ENVIRON["TOP"], top, "\\n")
              for (i = 1; i <= n; i++) { k = top[i]; sub(/[[:blank:]]*=.*/, "", k); want[k] = i }
              tables = ENVIRON["TABLES"]
            }
            function rest(  i) { for (i = 1; i <= n; i++) if (!(i in done)) print top[i]; intables = 1 }
            /^[[:blank:]]*[[][^]]*[]][[:blank:]]*(#.*)?$/ {
              if (!intables) rest()
              name = $0; sub(/^[[:blank:]]*[[][[:blank:]]*"?/, "", name); sub(/"?[[:blank:]]*[]].*/, "", name)
              if (tables != "" && (name == "servers" || name == "forced-hosts")) {
                if (!put) { printf "%s", tables; put = 1 }
                skip = 1; held = ""; next
              }
              if (skip) { printf "%s", held; skip = 0 }
              print; next
            }
            skip {
              if ($0 ~ /^[[:blank:]]*(#.*)?$/) held = held $0 "\\n"; else held = ""
              next
            }
            !intables && /^[[:blank:]]*[A-Za-z0-9_-]+[[:blank:]]*=/ {
              k = $0; sub(/^[[:blank:]]*/, "", k); sub(/[[:blank:]]*=.*/, "", k)
              if (k in want) { if (!(want[k] in done)) print top[want[k]]; done[want[k]] = 1; next }
            }
            { print }
            END {
              if (!intables) rest()
              if (skip) printf "%s", held
              if (tables != "" && !put) { print ""; printf "%s", tables }
            }' velocity.toml > velocity.toml.next
          mv -f velocity.toml.next velocity.toml
        else
          if [ "$EULA" = 1 ]; then echo eula=true > eula.txt; fi
          # Behind a proxy, the folder is the user minecraft's alone, as StateDirectoryMode makes a new
          # one: Paper keeps the proxy's secret in config/paper-global.yml.
          if [ -n "$BEHIND" ]; then chmod 750 .; fi
          # Out from behind a proxy: online again, on every address.
          was=$(cat .seal-mc/behind 2>/dev/null || true)
          if [ -z "$BEHIND" ] && [ -n "$was" ]; then PROPERTIES=(online-mode=true server-ip= "${PROPERTIES[@]}"); fi
          touch server.properties
          for kv in "server-port=$PORT" "${PROPERTIES[@]}"; do
            KV=$kv awk 'BEGIN { kv = ENVIRON["KV"]; k = substr(kv, 1, index(kv, "=")) }
              index($0, k) == 1 { if (!done) print kv; done = 1; next }
              { print }
              END { if (!done) print kv }' server.properties > server.properties.next
            mv -f server.properties.next server.properties
          done
          # Paper takes a proxy's forwarding in config/paper-global.yml (modern, whose secret comes as it
          # starts, in PAPER_VELOCITY_SECRET) or spigot.yml (legacy), and leaves it when out from behind.
          if [ "$LOADER" = paper ] && { [ -n "$BEHIND" ] || [ -n "$was" ]; }; then
            mkdir -p config
            touch config/paper-global.yml spigot.yml
            modern=false
            legacy=false
            if [ "$BEHIND" = MODERN ]; then modern=true; fi
            if [ "$BEHIND" = LEGACY ]; then legacy=true; fi
            MODERN=$modern yq -i '.proxies.velocity.enabled = env(MODERN) | .proxies.velocity["online-mode"] = true
              | .proxies["bungee-cord"]["online-mode"] = true' config/paper-global.yml
            LEGACY=$legacy yq -i '.settings.bungeecord = env(LEGACY)' spigot.yml
          fi
          echo "$BEHIND" > .seal-mc/behind
        fi
        """;
}
