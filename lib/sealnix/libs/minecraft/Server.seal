package sealnix.libs.minecraft;

import sealnix.*;
import seal.util.List;

// Minecraft servers on NixOS, for a seal-nix configuration: each a systemd service, minecraft-<name>,
// with its loader, and its mods or plugins from Modrinth. With seal-nix-libs's module in the system,
// a configuration imports the package; then each server is a Server, whose methods give its settings
// and return it, and whose install() makes it so:
//
//     import sealnix.libs.minecraft.*;
//
//     new Server("smp")
//         .loader(Loader.FABRIC)
//         .minecraftVersion("26.3")                 // Mojang's version, or "latest"
//         .acceptEula()                             // Mojang's EULA: https://aka.ms/MinecraftEULA
//         .memory("4G")
//         .modrinthMod("fabric-api")                // a Modrinth project, by its slug or ID
//         .modrinthMod("lithium", "mc26.3-0.26.3-fabric")  // one version of it, by version number or ID
//         .curseforgeMod("jei")                     // a CurseForge project, by its slug or ID
//         .property("motd", "A Seal server")        // server.properties
//         .install();
//
// The loaders: VANILLA, FABRIC, FORGE and NEOFORGE (mods), PAPER (plugins). install() checks the
// settings first, and stops the build with what is wrong. A Velocity proxy is a Proxy, whose file says
// how; Server and Proxy are each a Service, whose settings they share.
//
// seal-nix runs Seal while Nix builds, which has no network, so the server downloads on the machine,
// when its service starts (preStart): the loader, then each mod or plugin, each checked against the
// hash its source gives (Mojang's sha1, PaperMC's sha256, Modrinth's sha512, Forge's and NeoForge's
// Maven sha1). What a start chose is kept in .seal-mc/, so the next one downloads nothing unless the
// configuration changed, or autoUpdate() asks for the newest at every start; a new loader or Minecraft
// version chooses every mod and plugin again. Mods and plugins this put there, which the configuration
// no longer names, are removed; ones put there by hand are kept.
//
// CurseForge's API takes a key: Server.setCurseForgeKeyFile("/run/secrets/curseforge"), once, before
// the first install(). The file is read on the machine, so the key stays out of the Nix store. Without
// one, a mod comes through CurseForge's website instead, by its project ID alone, its size checked.
//
// A mod's or plugin's own config file is a ConfigFile, whose settings are set at every start, in a
// .toml, .yaml, .json, .json5 or .properties file; a key the configuration no longer sets goes:
//
//     .config(new ConfigFile("config/mymod.toml").set("general.threads", 4).set("general.fastMath", true))
//
// docs/minecraft, in seal-nix-libs, is all of it: every setting, the proxy, the service, the errors.
//
// A server lives in /var/lib/minecraft/<name>, runs as the user minecraft, and saves and stops on
// systemctl stop. nixos-rebuild switch restarts a server whose configuration changed. The first start
// of a Forge or NeoForge server runs its installer, which takes a few minutes.
class Server extends(Service<Server>) {
    Loader loaderType = Loader.VANILLA;
    bit loaderGiven = false;
    string minecraft = "";                   // "26.3", "1.21.1", or "latest" (the newest when first installed)
    bit eula = false;
    List<Service.Project> mods = new List();
    List<string> propertyKeys = new List();
    List<string> propertyValues = new List();
    List<Player> ops = new List();
    List<Player> bans = new List();
    List<Player> allowed = new List();       // the whitelist

    // A player named in ops.json, at a level, or in banned-players.json or whitelist.json, at level 0.
    record Player(string name, string uuid, int level) { }

    private<Proxy> Proxy proxy = null;       // the proxy this is behind, once given to one

    static string curseforgeKeyPath = "";    // the file with the CurseForge API key, for every server
    static bit installedWithoutKey = false;  // a server has taken CurseForge's mods without it

    // A server, by its name: letters, digits, - and _. Its service is minecraft-<name>, and its folder
    // /var/lib/minecraft/<name>.
    public new(string name) {
        super(name);
        self = this;
    }

    // Its loader: Loader.VANILLA (Mojang's server), FABRIC, FORGE or NEOFORGE (mods), or PAPER (plugins).
    public Server loader(Loader loader) {
        loaderType = loader;
        loaderGiven = true;
        return this;
    }

    // Its Minecraft version: Mojang's, "26.3", "1.21.1", or "latest", the newest at the first start.
    public Server minecraftVersion(string version) {
        minecraft = version;
        return this;
    }

    // Mojang's EULA, https://aka.ms/MinecraftEULA: without it, no server starts.
    public Server acceptEula() {
        eula = true;
        return this;
    }

    // The file with the CurseForge API key, once for the whole configuration, before the first
    // install(): a path, as "/run/secrets/curseforge", that the user minecraft can read, so that the key
    // itself stays out of the Nix store. CurseForge's developer console gives the key.
    public static void setCurseForgeKeyFile(string file) {
        if (!file.startsWith("/") || !plain(file, "/._-+@")) {
            throw new IllegalArgumentException("the CurseForge API key is given by the path of a file that holds it, as "
                + "\"/run/secrets/curseforge\", so that the key stays out of the Nix store");
        }
        if (installedWithoutKey) {
            throw new IllegalStateException("the CurseForge API key's file comes after a server with CurseForge mods was "
                + "installed without it: set it before the first install()");
        }
        if (curseforgeKeyPath.length() > 0 && curseforgeKeyPath != file) {
            throw new IllegalStateException("the CurseForge API key's file is set twice: \"" + curseforgeKeyPath + "\" and \""
                + file + "\"; set it once");
        }
        curseforgeKeyPath = file;
    }

    // Fabric, Forge, NeoForge: a mod from Modrinth, by its slug or ID, in its newest version for the
    // server's loader and Minecraft version.
    public Server modrinthMod(string project) {
        return modrinthMod(project, "");
    }

    // That version of it: its version number as Modrinth has it, whole ("mc26.3-0.26.3-fabric"), or
    // its version ID.
    public Server modrinthMod(string project, string version) {
        mods.add(new Service.Project(project, version, false));
        return this;
    }

    // A mod from CurseForge, by its slug or ID, in its newest file for the server's loader and
    // Minecraft version. Without setCurseForgeKeyFile(), only its ID will do.
    public Server curseforgeMod(string project) {
        return curseforgeMod(project, "");
    }

    // That file of it: its file ID, its file name ("jei-26.3-fabric-31.17.0.109.jar"), or its display
    // name, whole.
    public Server curseforgeMod(string project, string file) {
        mods.add(new Service.Project(project, file, true));
        return this;
    }

    // A line of server.properties, set at every start: property("max-players", "20").
    public Server property(string key, string value) {
        int at = propertyKeys.indexOf(key);
        if (at >= 0) {
            propertyValues.set(at, value);
        } else {
            propertyKeys.add(key);
            propertyValues.add(value);
        }
        return this;
    }

    // An operator, in ops.json at every start: the player's name, their UUID, with or without its
    // dashes, and a permission level from 1 to 4, where 4 can do everything. Operators made in the game
    // are kept; one no longer given here is taken out.
    public Server op(string name, string uuid, int level) {
        ops.add(new Player(name, uuid, level));
        return this;
    }

    // A player banned, in banned-players.json at every start: their name, and their UUID. Bans made in
    // the game are kept; one no longer given here is lifted.
    public Server ban(string name, string uuid) {
        bans.add(new Player(name, uuid, 0));
        return this;
    }

    // A player on the whitelist, in whitelist.json at every start: their name, and their UUID. Giving
    // anyone turns the whitelist on. Players added in the game are kept; one no longer given here is
    // taken off. Taking the last one out leaves it on: property("white-list", "false") turns it off.
    public Server whitelist(string name, string uuid) {
        allowed.add(new Player(name, uuid, 0));
        return this;
    }

    // The service, its user, and the port. A server given to a proxy is the proxy's to install.
    public void install() {
        if (proxy != null) {
            throw new IllegalStateException("Minecraft server " + name + " is behind the proxy " + proxy.name
                + ", whose install() installs it: leave out " + name + "'s own");
        }
        super.install();
    }

    private<Service> string loaderId() {
        return switch (loaderType) {
            case VANILLA -> "vanilla";
            case FABRIC -> "fabric";
            case FORGE -> "forge";
            case NEOFORGE -> "neoforge";
            case PAPER -> "paper";
        };
    }

    private<Service> string mcVersion() { return minecraft; }
    private<Service> string versionShown() { return minecraft; }
    private<Service> Proxy front() { return proxy; }
    private<Service> bit eulaAccepted() { return eula; }
    private<Service> string behindMode() { return proxy != null ? proxy.forwardingMode.name() : ""; }
    private<Service> string secretPath() { return proxy != null ? proxy.secretPath() : ""; }
    private<Service> string curseforgeKeyFile() { return usesCurseforge() ? curseforgeKeyPath : ""; }

    // The operators given, as JSON for the start.
    private<Service> string opsJson() {
        StringBuilder b = new StringBuilder();
        for (Player p : ops) {
            b.append(b.length() > 0 ? "," : "").append(playerJson(p)).append(",\"level\":").append(p.level).append('}');
        }
        return "[" + b.toString() + "]";
    }

    // The players banned, as JSON for the start: for good, since the configuration says so at every start.
    private<Service> string bansJson() {
        StringBuilder b = new StringBuilder();
        for (Player p : bans) {
            b.append(b.length() > 0 ? "," : "").append(playerJson(p)).append(",\"expires\":\"forever\"}");
        }
        return "[" + b.toString() + "]";
    }

    // The whitelist, as JSON for the start.
    private<Service> string whitelistJson() {
        StringBuilder b = new StringBuilder();
        for (Player p : allowed) {
            b.append(b.length() > 0 ? "," : "").append(playerJson(p)).append('}');
        }
        return "[" + b.toString() + "]";
    }

    // The start of a player's entry, its object left open.
    string playerJson(Player p) {
        return "{\"uuid\":" + ConfigFile.quote(canonical(p.uuid)) + ",\"name\":" + ConfigFile.quote(p.name);
    }

    // A UUID as the game's files have it, in lower case with its dashes, or empty if it isn't one.
    // Mojang's API gives them without the dashes, and a server ignores an entry without them, unsaid.
    static string canonical(string uuid) {
        StringBuilder digits = new StringBuilder();
        for (int k = 0; k < uuid.length(); k++) {
            if (uuid.charAt(k) != '-') { digits.append(uuid.charAt(k)); }
        }
        string hex = digits.toString().toLower();
        if (hex.length() != 32 || (uuid.contains("-") && uuid.length() != 36)) { return ""; }
        for (int k = 0; k < hex.length(); k++) {
            char c = hex.charAt(k);
            if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) { return ""; }
        }
        return hex.substring(0, 8) + "-" + hex.substring(8, 12) + "-" + hex.substring(12, 16) + "-"
            + hex.substring(16, 20) + "-" + hex.substring(20, 32);
    }

    // Whether it is all digits, as a CurseForge project ID.
    static bit digits(string s) {
        for (int k = 0; k < s.length(); k++) {
            if (s.charAt(k) < '0' || s.charAt(k) > '9') { return false; }
        }
        return s.length() > 0;
    }

    bit usesCurseforge() {
        for (Service.Project m : mods) {
            if (m.curseforge) { return true; }
        }
        return false;
    }

    // The Java the Minecraft version needs: 25 from 26.1, 21 from 1.20.5, 17 from 1.17, else 8.
    private<Service> Pkg defaultJava() {
        if (!minecraft.startsWith("1.")) { return Packages.jdk25_headless; }
        int minor = number(minecraft, 1);
        int patch = number(minecraft, 2);
        if (minor > 20 || (minor == 20 && patch >= 5)) { return Packages.jdk21_headless; }
        if (minor >= 17) { return Packages.jdk17_headless; }
        return Packages.jdk8_headless;
    }

    private<Service> void checkKind(string about) {
        if (!loaderGiven) {
            throw new IllegalArgumentException(about + "no loader: loader(Loader.FABRIC), say, or Loader.VANILLA, "
                + "FORGE, NEOFORGE or PAPER; a proxy is a new Proxy(name)");
        }
        if (minecraft.length() == 0) {
            throw new IllegalArgumentException(about + "no Minecraft version: minecraftVersion(\"26.3\"), say, or "
                + "minecraftVersion(\"latest\")");
        }
        if (!plain(minecraft, ".-_+")) {
            throw new IllegalArgumentException(about + "no Minecraft version \"" + minecraft + "\"");
        }
        if (!eula) {
            throw new IllegalStateException(about + "a server runs only once its owner accepts "
                + "Mojang's EULA (https://aka.ms/MinecraftEULA): acceptEula()");
        }
        bit modded = loaderType == Loader.FABRIC || loaderType == Loader.FORGE || loaderType == Loader.NEOFORGE;
        if (!mods.isEmpty() && !modded) {
            throw new IllegalArgumentException(about + describe() + " takes no mods; Fabric, Forge and NeoForge do");
        }
        if (!plugins.isEmpty() && loaderType != Loader.PAPER) {
            throw new IllegalArgumentException(about + describe() + " takes no plugins; Paper and Velocity do");
        }
        for (Service.Project m : mods) {
            checkProject(m, m.curseforge ? "curseforgeMod" : "modrinthMod");
            if (m.curseforge && curseforgeKeyPath.length() == 0 && !digits(m.name)) {
                throw new IllegalStateException(about + "without an API key, CurseForge's site can't look up \"" + m.name
                    + "\": give its project ID, curseforgeMod(\"238222\"), or the key, "
                    + "Server.setCurseForgeKeyFile(\"/run/secrets/curseforge\"), once, before the first install()");
            }
            if (m.curseforge && curseforgeKeyPath.length() == 0) { installedWithoutKey = true; }
        }
        for (int k = 0; k < propertyKeys.size(); k++) {
            if (!plain(propertyKeys.get(k), ".-_") || propertyValues.get(k).contains("\n")) {
                throw new IllegalArgumentException(about + "no property " + propertyKeys.get(k));
            }
        }
        List<string> seen = new List();
        for (Player p : ops) {
            checkPlayer(about, p, seen, "op() or ban()");
            if (p.level < 1 || p.level > 4) {
                throw new IllegalArgumentException(about + "no operator level " + p.level + " for " + p.name + ": it is 1 to 4");
            }
        }
        for (Player p : bans) { checkPlayer(about, p, seen, "op() or ban()"); }
        // a list of its own: an operator can be on the whitelist too
        List<string> listed = new List();
        for (Player p : allowed) { checkPlayer(about, p, listed, "whitelist()"); }
    }

    // A player's name and UUID, which the server would otherwise drop from its file without a word.
    void checkPlayer(string about, Player p, List<string> seen, string method) {
        if (p.name.length() == 0 || p.name.contains("\n") || p.name.contains("\t")) {
            throw new IllegalArgumentException(about + "no player \"" + p.name + "\"");
        }
        string id = canonical(p.uuid);
        if (id.length() == 0) {
            throw new IllegalArgumentException(about + p.name + "'s UUID \"" + p.uuid + "\" isn't one: "
                + "32 hexadecimal digits, as 069a79f4-44e9-4726-a5be-fca90e38aaf5");
        }
        if (seen.contains(id)) {
            throw new IllegalArgumentException(about + "the player " + id + " (" + p.name + ") is given twice: " + method + ", once");
        }
        seen.add(id);
    }

    // Whether this takes the proxy's forwarding as this file sets it up: any server takes NONE, Paper
    // MODERN and LEGACY, Fabric and NeoForge MODERN.
    private<Proxy> void checkBehind(Proxy given) {
        Forwarding f = given.forwardingMode;
        bit paper = loaderType == Loader.PAPER && (f == Forwarding.MODERN || f == Forwarding.LEGACY);
        bit fabric = loaderType == Loader.FABRIC && f == Forwarding.MODERN;
        bit neoforge = loaderType == Loader.NEOFORGE && f == Forwarding.MODERN;
        if (f != Forwarding.NONE && !paper && !fabric && !neoforge) {
            throw new IllegalArgumentException("Minecraft server " + given.name + ": " + name + " (" + describe() + ") can't "
                + "take " + f.name() + " forwarding as this sets it up (Paper takes MODERN or LEGACY, Fabric and NeoForge "
                + "MODERN): give the proxy forwarding(Forwarding.NONE), or set up " + name + " by hand and give the proxy its address");
        }
        if (neoforge && minecraft.startsWith("1.") && number(minecraft, 1) < 21) {
            throw new IllegalArgumentException("Minecraft server " + given.name + ": " + name + " is NeoForge " + minecraft
                + "; behind a proxy's MODERN forwarding, NeoForge is 1.21 or newer, which NeoVelocity is for");
        }
        if (loaderType == Loader.PAPER && minecraft.startsWith("1.") && number(minecraft, 1) < 19) {
            throw new IllegalArgumentException("Minecraft server " + given.name + ": " + name + " is Paper " + minecraft
                + "; behind a proxy, Paper is 1.19 or newer, whose config/paper-global.yml this sets");
        }
    }

    // The variable a server behind a proxy's modern forwarding finds its secret in as it starts:
    // Paper's PAPER_VELOCITY_SECRET, FabricProxy-Lite's FABRIC_PROXY_SECRET; empty for none.
    private<Service> string secretVariable() {
        if (proxy == null || proxy.forwardingMode != Forwarding.MODERN) { return ""; }
        if (loaderType == Loader.PAPER) { return "PAPER_VELOCITY_SECRET"; }
        if (loaderType == Loader.FABRIC) { return "FABRIC_PROXY_SECRET"; }
        return "";
    }

    // Whether it is NeoForge, behind a proxy's modern forwarding, which NeoVelocity takes.
    bit neoVelocity() {
        return loaderType == Loader.NEOFORGE && proxy != null && proxy.forwardingMode == Forwarding.MODERN;
    }

    // Whether it reads the proxy's secret as it starts, so that a start with none to read says so.
    private<Service> bit readsSecret() {
        return secretVariable().length() > 0 || neoVelocity();
    }

    // The config files a start applies: those given, and NeoVelocity's, told to read the proxy's secret
    // from its file, so that its config holds the path alone. What is given for that file comes after,
    // and so wins; a text() is the whole file, as given.
    private<Service> List<ConfigFile> configFiles() {
        if (!neoVelocity()) { return configs; }
        ConfigFile neo = new ConfigFile("config/neovelocity-common.toml")
            .set("forwarding.forwarding-secret", secretPath())
            .set("forwarding.forwarding-secret-type", "FILE");
        List<ConfigFile> files = new List();
        for (ConfigFile c : configs) {
            if (c.filePath() == neo.filePath()) { neo = neo.under(c); } else { files.add(c); }
        }
        files.add(neo);
        return files;
    }

    // The mods given; behind a proxy's modern forwarding, Fabric's with FabricProxy-Lite and the
    // Fabric API it needs, and NeoForge's with NeoVelocity.
    private<Service> List<string> modSpecs() {
        List<Service.Project> list = copyOf(mods);
        if (loaderType == Loader.FABRIC && proxy != null && proxy.forwardingMode == Forwarding.MODERN) {
            for (string slug : ["fabric-api", "fabricproxy-lite"]) {
                if (!names(list, slug)) { list.add(new Service.Project(slug, "", false)); }
            }
        }
        if (neoVelocity() && !names(list, "neovelocity")) { list.add(new Service.Project("neovelocity", "", false)); }
        return specs(list);
    }

    // server.properties' lines: behind a proxy, offline (the proxy signs players in) on 127.0.0.1;
    // then the properties given, which come after, and so win.
    private<Service> List<string> propertyLines() {
        List<string> lines = new List();
        if (proxy != null) {
            lines.add("online-mode=false");
            lines.add("server-ip=127.0.0.1");
        }
        if (!allowed.isEmpty()) { lines.add("white-list=true"); }
        for (int k = 0; k < propertyKeys.size(); k++) { lines.add(propertyKeys.get(k) + "=" + propertyValues.get(k)); }
        return lines;
    }

    static <T> List<T> copyOf(List<T> list) {
        List<T> copy = new List();
        for (T x : list) { copy.add(x); }
        return copy;
    }

    // Whether a Modrinth project is among those given, in any version.
    static bit names(List<Service.Project> projects, string slug) {
        for (Service.Project p : projects) {
            if (p.name == slug) { return true; }
        }
        return false;
    }

    // The number at a place in a version: number("1.20.5", 2) is 5; 0 where there is none.
    static int number(string version, int place) {
        int at = 0;
        int value = 0;
        for (int k = 0; k < version.length(); k++) {
            char c = version.charAt(k);
            if (c == '.') {
                if (at == place) { return value; }
                at++;
                value = 0;
            } else if (at == place) {
                if (c < '0' || c > '9') { return value; }
                value = value * 10 + (c - '0');
            }
        }
        return at == place ? value : 0;
    }
}
