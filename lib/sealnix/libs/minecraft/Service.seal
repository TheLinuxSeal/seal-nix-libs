package sealnix.libs.minecraft;

import sealnix.*;
import seal.util.List;

// What a Server and a Proxy have in common: a systemd service, minecraft-<name>, that downloads its
// loader and its plugins when it starts, and the settings of that. T is the Server or Proxy, which
// the settings return, so that they chain with its own. It isn't made by itself: new Server(name) or
// new Proxy(name).
abstract class Service<T> {
    // The names of the services installed: each is a service and a folder of its own.
    private<Server, Proxy> static List<string> installed = new List();

    // A mod or plugin, from Modrinth or CurseForge: its project, by slug or ID, and its version, on
    // Modrinth by version number or ID, on CurseForge by file ID, file name or display name; empty for
    // the newest.
    public record Project(string name, string version, bit curseforge) {
        // As the start reads it: slug, or slug@version, and curseforge: before CurseForge's.
        string spec() { return (curseforge ? "curseforge:" : "") + (version.length() == 0 ? name : name + "@" + version); }
    }

    // The settings, which the methods of their names give: each field is named apart from its method,
    // which Seal asks.
    private<Server, Proxy> string name;
    private<Server, Proxy> T self;           // this, as what the settings return
    private<Server, Proxy> string loaderRelease = "";    // the loader's own version; empty for the newest
    int portNumber = 0;
    bit portGiven = false;                   // else the service's own
    string heap = "2G";
    List<string> jvmArgs = new List();
    bit firewall = true;
    private<Server> bit updates = false;
    private<Server, Proxy> List<Project> plugins = new List();
    private<Server> List<ConfigFile> configs = new List();
    Pkg customJdk = null;                    // null for the one the service needs

    private<Server, Proxy> new(string name) {
        this.name = name;
    }

    // Fabric's loader, Forge's or NeoForge's version, Paper's build, Velocity's version; the newest
    // unless given (Forge's recommended, if it has one).
    public T loaderVersion(string version) {
        loaderRelease = version;
        return self;
    }

    // 25565 unless given; a proxy's, 25577.
    public T port(int port) {
        portNumber = port;
        portGiven = true;
        return self;
    }

    // The Java heap, -Xms and -Xmx: "4G", "512M"; 2G unless given.
    public T memory(string size) {
        heap = size;
        return self;
    }

    // An argument for java, before the server's own: jvmArg("-XX:+UseZGC").
    public T jvmArg(string arg) {
        jvmArgs.add(arg);
        return self;
    }

    // The port, in networking.firewall.allowedTCPPorts unless openFirewall(false). A server behind a
    // proxy, which only the proxy reaches, never is.
    public T openFirewall(bit open) {
        firewall = open;
        return self;
    }

    // The newest loader, mods and plugins at every start, not only the first.
    public T autoUpdate() {
        updates = true;
        return self;
    }

    // Paper, Velocity: a plugin, a Modrinth project by its slug or ID, in its newest version for the
    // loader and Minecraft version.
    public T plugin(string project) {
        return plugin(project, "");
    }

    // That version of it: its version number as Modrinth has it, whole ("v5.5.71-bukkit"), or its
    // version ID.
    public T plugin(string project, string version) {
        plugins.add(new Project(project, version, false));
        return self;
    }

    // A config file of a mod or plugin, or any other file in the server's folder: see ConfigFile.
    public T config(ConfigFile file) {
        configs.add(file);
        return self;
    }

    // The Java to run; the one the service needs unless given.
    public T jdk(Pkg jdk) {
        customJdk = jdk;
        return self;
    }

    // The service, its user, and the port. The settings are checked first.
    public void install() {
        check();
        installService();
    }

    // What differs between a Server and a Proxy, which they say.
    private<Server, Proxy> string loaderId() { return ""; }          // the start's LOADER
    private<Server, Proxy> string mcVersion() { return "latest"; }   // the start's MC
    private<Server, Proxy> bit choosesAtStart() { return updates; }  // its mods are chosen at each start, not in minecraft.lock
    private<Server, Proxy> string versionShown() { return ""; }      // in the service's description
    private<Server, Proxy> int defaultPort() { return 25565; }
    private<Server, Proxy> Pkg defaultJava() { return Packages.jdk25_headless; }
    private<Server, Proxy> string extraTools() { return ""; }
    private<Server, Proxy> Proxy front() { return null; }            // the proxy this is behind
    private<Server, Proxy> void checkKind(string about) { }
    private<Server, Proxy> bit eulaAccepted() { return false; }
    private<Server, Proxy> List<string> modSpecs() { return new List(); }
    private<Server, Proxy> List<string> propertyLines() { return new List(); }
    private<Server, Proxy> string behindMode() { return ""; }        // the forwarding of the proxy this is behind
    private<Server, Proxy> string forwardingName() { return ""; }    // a proxy's own
    private<Server, Proxy> string secretPath() { return ""; }        // the forwarding secret's file
    private<Server, Proxy> bit ownsSecret() { return false; }
    private<Server, Proxy> string serversToml() { return ""; }
    private<Server, Proxy> string secretVariable() { return ""; }    // where the server finds the secret
    private<Server, Proxy> bit readsSecret() { return false; }       // whether it reads it as it starts
    private<Server, Proxy> List<ConfigFile> configFiles() { return configs; }   // the config files a start applies
    private<Server, Proxy> string curseforgeKeyFile() { return ""; } // the API key's file, if it has CurseForge mods
    private<Server, Proxy> string opsJson() { return "[]"; }         // the operators given, as JSON
    private<Server, Proxy> string bansJson() { return "[]"; }        // the players banned, as JSON
    private<Server, Proxy> string whitelistJson() { return "[]"; }   // the whitelist, as JSON

    // The port it listens on: the one given, or its own.
    private<Server, Proxy> int listenPort() {
        return portGiven ? portNumber : defaultPort();
    }

    private<Server, Proxy> void installService() {
        if (installed.contains(name)) {
            throw new IllegalStateException("Minecraft server " + name + " is installed twice: install each server "
                + "once, each with a name of its own");
        }
        installed.add(name);
        string unit = "minecraft-" + name;
        Proxy before = front();

        Config.users.users.minecraft.isSystemUser = true;
        Config.users.users.minecraft.group = "minecraft";
        Config.users.users.minecraft.home = "/var/lib/minecraft";
        Config.users.groups.get("minecraft");

        Config.systemd.services.get(unit).description = "Minecraft server " + name + " (" + describe() + ")"
            + (before != null ? ", behind " + before.name : "");
        Config.systemd.services.get(unit).wantedBy.add("multi-user.target");
        Config.systemd.services.get(unit).after.add("network-online.target");
        Config.systemd.services.get(unit).wants.add("network-online.target");
        if (before != null) {
            // the proxy first, which makes the forwarding secret this reads
            Config.systemd.services.get(unit).after.add("minecraft-" + before.name + ".service");
            Config.systemd.services.get(unit).wants.add("minecraft-" + before.name + ".service");
        }
        Config.systemd.services.get(unit).preStart = prepareScript();
        Config.systemd.services.get(unit).script = startScript();
        Config.systemd.services.get(unit).serviceConfig.set("User", "minecraft");
        Config.systemd.services.get(unit).serviceConfig.set("Group", "minecraft");
        Config.systemd.services.get(unit).serviceConfig.set("StateDirectory", "minecraft/" + name);
        if (before != null) {
            // the proxy's secret, which Paper writes into its config, is no one else's to read
            Config.systemd.services.get(unit).serviceConfig.set("StateDirectoryMode", "0750");
        }
        Config.systemd.services.get(unit).serviceConfig.set("WorkingDirectory", "/var/lib/minecraft/" + name);
        Config.systemd.services.get(unit).serviceConfig.set("Restart", "on-failure");
        Config.systemd.services.get(unit).serviceConfig.set("RestartSec", 10);
        Config.systemd.services.get(unit).serviceConfig.set("TimeoutStartSec", "20min");       // the first start downloads, and installs Forge
        Config.systemd.services.get(unit).serviceConfig.set("TimeoutStopSec", 120);            // time to save the worlds
        Config.systemd.services.get(unit).serviceConfig.set("SuccessExitStatus", "0 143");     // 143: stopped by SIGTERM, having saved
        Config.systemd.services.get(unit).serviceConfig.set("PrivateTmp", true);
        Config.systemd.services.get(unit).serviceConfig.set("NoNewPrivileges", true);
        Config.systemd.services.get(unit).serviceConfig.set("ProtectSystem", "strict");
        Config.systemd.services.get(unit).serviceConfig.set("ProtectHome", true);
        Config.setRaw("systemd.services." + unit + ".path", "[ " + tools() + " ]");
        // Its mods and plugins, from minecraft.lock, as Nix downloads them, unless a start chooses them.
        if (!choosesAtStart() && (!modSpecs().isEmpty() || !plugins.isEmpty())) {
            installLock();
            Config.setRaw("system.build.minecraftRequests.minecraft-" + name, nix(lockRequest()));
            Config.setRaw("systemd.services." + unit + ".environment.DOWNLOADED", "config.system.build.minecraftDownloads \"" + name + "\"");
        }

        if (firewall && before == null) { Config.networking.firewall.allowedTCPPorts.add(listenPort()); }
    }

    private<Server, Proxy> void check() {
        string about = "Minecraft server " + name + ": ";
        if (!plain(name, "-_") || name.length() == 0) {
            throw new IllegalArgumentException("Minecraft server \"" + name + "\": a name is letters, digits, - and _");
        }
        checkKind(about);
        if (!plain(loaderRelease, ".-_+")) {
            throw new IllegalArgumentException(about + "no loader version \"" + loaderRelease + "\"");
        }
        if (!plain(heap, "") || heap.length() == 0) {
            throw new IllegalArgumentException(about + "memory is a size, as \"4G\" or \"512M\"");
        }
        if (portGiven && (portNumber < 1 || portNumber > 65535)) {
            throw new IllegalArgumentException(about + "no port " + portNumber);
        }
        for (Project p : plugins) { checkProject(p, "plugin"); }
        for (int k = 0; k < configs.size(); k++) {
            configs.get(k).check(about);
            for (int j = 0; j < k; j++) {
                if (configs.get(j).filePath() == configs.get(k).filePath()) {
                    throw new IllegalArgumentException(about + "two config files are \"" + configs.get(k).filePath()
                        + "\"; give all its settings to one");
                }
            }
        }
    }

    private<Server, Proxy> void checkProject(Project p, string kind) {
        string about = "Minecraft server " + name + ": ";
        string site = p.curseforge ? "CurseForge" : "Modrinth";
        int at = p.name.indexOf('@');
        if (at > 0) {
            throw new IllegalArgumentException(about + "no " + site + " project \"" + p.name + "\": a version is "
                + kind + "'s second argument, " + kind + "(\"" + p.name.substring(0, at) + "\", \""
                + p.name.substring(at + 1, p.name.length()) + "\")");
        }
        if (p.name.length() == 0 || !plain(p.name, ".-_+")) {
            throw new IllegalArgumentException(about + "no " + site + " project \"" + p.name + "\"");
        }
        if (p.version.contains("\t") || p.version.contains("\n")) {
            throw new IllegalArgumentException(about + "no version \"" + p.version + "\" of " + p.name);
        }
    }

    private<Server, Proxy> string describe() {
        string version = versionShown();
        return loaderId() + (version.length() > 0 ? " " + version : "");
    }

    Pkg java() {
        return customJdk != null ? customJdk : defaultJava();
    }

    // What preStart runs with. yq edits config files, on every server, since a start may have to take
    // settings out of one the configuration no longer has; Python reads the JSON5 of files whose keys
    // are set.
    string tools() {
        string more = extraTools();
        for (ConfigFile c : configs) {
            if (c.editsJson5()) {
                more = more + " (pkgs.python3.withPackages (ps: [ ps.json5 ]))";
                break;
            }
        }
        return "" + Packages.curl + " " + Packages.jq + " " + Packages.coreutils + " " + Packages.gawk + " "
            + Packages.gnugrep + " " + Packages.yq_go + " " + java() + more;
    }

    // The config files, as JSON for the start.
    string configsJson() {
        StringBuilder b = new StringBuilder();
        for (ConfigFile c : configFiles()) {
            b.append(b.length() > 0 ? "," : "").append(c.spec());
        }
        return "[" + b.toString() + "]";
    }

    string prepareScript() {
        StringBuilder b = new StringBuilder();
        b.append("set -euo pipefail\n");
        b.append("LOADER=").append(loaderId()).append('\n');
        b.append("MC=").append(sh(mcVersion())).append('\n');
        b.append("LOADER_VERSION=").append(sh(loaderRelease)).append('\n');
        b.append("PORT=").append(listenPort()).append('\n');
        b.append("AUTO_UPDATE=").append(updates ? "1" : "0").append('\n');
        b.append("EULA=").append(eulaAccepted() ? "1" : "0").append('\n');
        b.append("MODS=(").append(words(modSpecs())).append(")\n");
        b.append("PLUGINS=(").append(words(specs(plugins))).append(")\n");
        b.append("PROPERTIES=(").append(words(propertyLines())).append(")\n");
        b.append("BEHIND=").append(behindMode()).append('\n');
        b.append("FORWARDING=").append(forwardingName()).append('\n');
        b.append("SECRET=").append(sh(secretPath())).append('\n');
        b.append("OWN_SECRET=").append(ownsSecret() ? "1" : "0").append('\n');
        b.append("SERVERS=").append(sh(serversToml())).append('\n');
        b.append("CONFIGS=").append(sh(configsJson())).append('\n');
        b.append("CURSEFORGE_KEY=").append(sh(curseforgeKeyFile())).append('\n');
        b.append("OPS=").append(sh(opsJson())).append('\n');
        b.append("BANS=").append(sh(bansJson())).append('\n');
        b.append("WHITELIST=").append(sh(whitelistJson())).append('\n');
        b.append("DOWNLOADED=${DOWNLOADED:-}\n");                  // what Nix downloaded, from minecraft.lock
        b.append("FROM_NIX=").append(choosesAtStart() ? "0" : "1").append('\n');   // whether that's all its mods
        b.append(TOOLS).append(CHOOSE_LOADER).append(MOD_SOURCES).append(SYNC_ALL).append(SETTINGS);
        return b.toString();
    }

    // What minecraft.lock needs to know of it, as JSON: its loader, Minecraft version, mods, plugins, and
    // CurseForge key's file.
    string lockRequest() {
        return "{\"loader\":" + ConfigFile.quote(loaderId()) + ",\"minecraft\":" + ConfigFile.quote(mcVersion())
            + ",\"mods\":" + jsonList(modSpecs()) + ",\"plugins\":" + jsonList(specs(plugins))
            + ",\"curseforgeKey\":" + ConfigFile.quote(curseforgeKeyFile()) + "}";
    }

    static string jsonList(List<string> items) {
        StringBuilder b = new StringBuilder();
        for (string s : items) { b.append(b.length() > 0 ? "," : "").append(ConfigFile.quote(s)); }
        return "[" + b.toString() + "]";
    }

    static bit lockInstalled = false;

    // minecraft.lock, once for every server: where it is, what Nix makes of it, and the nixos-rebuild that
    // keeps it, which takes the place of NixOS's own in the system's commands, and runs it.
    static void installLock() {
        if (lockInstalled) { return; }
        lockInstalled = true;
        Config.setRaw("system.build.minecraftLockFile", LOCK_FILE);
        Config.setRaw("system.build.minecraftDownloads", DOWNLOADS);
        Config.environment.systemPackages.add(new Pkg("(lib.hiPrio (pkgs.writeShellScriptBin \"nixos-rebuild\" (\"export PATH=${lib.makeBinPath [ "
            + Packages.curl + " " + Packages.jq + " " + Packages.coreutils + " " + Packages.gawk + " " + Packages.gnugrep + " "
            + Packages.diffutils + " " + Packages.git + " " + Packages.util_linux + " config.nix.package ]}:$PATH\\n"
            + "REAL=${config.system.build.nixos-rebuild}/bin/nixos-rebuild\\n\" + " + nix(REBUILD + TOOLS + MOD_SOURCES + LOCKING) + ")))"));
    }

    // A string, as Nix code.
    static string nix(string s) {
        StringBuilder b = new StringBuilder();
        b.append('"');
        for (int k = 0; k < s.length(); k++) {
            char c = s.charAt(k);
            if (c == '"' || c == '\\' || c == '$') { b.append('\\'); }
            b.append(c);
        }
        b.append('"');
        return b.toString();
    }

    string startScript() {
        StringBuilder b = new StringBuilder();
        b.append("set -euo pipefail\n");
        b.append("mapfile -t launch < .seal-mc/launch\n");
        string variable = secretVariable();
        if (readsSecret()) {
            // the proxy's secret, which the server takes from its environment, or from the secret's own
            // file, so no file of its own holds it
            b.append("SECRET=").append(sh(secretPath())).append('\n');
            b.append("if ! secret=$(cat -- \"$SECRET\") || [ -z \"$secret\" ]; then\n");
            b.append("  echo \"minecraft: no forwarding secret to read in $SECRET, which minecraft-")
                .append(front().name).append(" signs with\" >&2\n");
            b.append("  exit 1\n");
            b.append("fi\n");
            if (variable.length() > 0) { b.append("export ").append(variable).append("=$secret\n"); }
        }
        b.append("exec java -Xms").append(heap).append(" -Xmx").append(heap);
        for (string a : jvmArgs) { b.append(' ').append(sh(a)); }
        b.append(" \"${launch[@]}\"\n");
        return b.toString();
    }

    private<Server, Proxy> static List<string> specs(List<Project> projects) {
        List<string> list = new List();
        for (Project p : projects) { list.add(p.spec()); }
        return list;
    }

    // Letters, digits, and the characters given.
    private<Server, Proxy> static bit plain(string s, string allowed) {
        for (int k = 0; k < s.length(); k++) {
            char c = s.charAt(k);
            bit ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9');
            for (int j = 0; j < allowed.length(); j++) {
                if (c == allowed.charAt(j)) { ok = true; }
            }
            if (!ok) { return false; }
        }
        return true;
    }

    // A word for the shell, in single quotes.
    private<Server, Proxy> static string sh(string s) {
        StringBuilder b = new StringBuilder();
        b.append('\'');
        for (int k = 0; k < s.length(); k++) {
            char c = s.charAt(k);
            if (c == '\'') {
                b.append("'\"'\"'");
            } else {
                b.append(c);
            }
        }
        b.append('\'');
        return b.toString();
    }

    private<Server, Proxy> static string words(List<string> list) {
        StringBuilder b = new StringBuilder();
        for (string s : list) {
            if (b.length() > 0) { b.append(' '); }
            b.append(sh(s));
        }
        return b.toString();
    }

    // What preStart runs, after the server's own settings (LOADER, MC, MODS...), in its parts: bash, with
    // curl and jq. A rebuild runs TOOLS, MOD_SOURCES and SYNC_ALL alone.
    static string TOOLS = """
        UA='seal-nix-libs minecraft (github.com/TheLinuxSeal/seal-nix-libs)'
        MOJANG=https://piston-meta.mojang.com/mc/game/version_manifest_v2.json
        mkdir -p .seal-mc

        log() { echo "minecraft: $*" >&2; }
        fail() { log "$*"; exit 1; }
        get() { curl -fsSL --retry 3 --retry-delay 2 -A "$UA" "$@"; }

        # fetch URL FILE ALGORITHM CHECKSUM [SIZE]: the file, checked, put in place only when it is whole
        fetch() {
          get -o "$2.part" "$1" || fail "can't download $1"
          if [ -n "$4" ] && [ "$("$3sum" "$2.part" | cut -d ' ' -f 1)" != "$4" ]; then
            rm -f "$2.part"
            fail "$1: the download's $3 isn't $4"
          fi
          if [ -n "${5:-}" ] && [ "$(stat -c %s "$2.part")" != "$5" ]; then
            rm -f "$2.part"
            fail "$1: the download isn't the $5 bytes it should be"
          fi
          mv -f "$2.part" "$2"
        }

        """;

    static string CHOOSE_LOADER = """
        # A Maven artifact's sha1, when the repository has one.
        mavensha1() { get "$1.sha1" 2>/dev/null | cut -d ' ' -f 1 || true; }

        # The loader: again only when the configuration asks for another, or for the newest each time.
        want="$LOADER $MC $LOADER_VERSION"
        if [ "$AUTO_UPDATE" = 1 ] || [ "$(cat .seal-mc/requested 2>/dev/null)" != "$want" ] || [ ! -s .seal-mc/launch ]; then
          if [ "$MC" = latest ] && [ "$LOADER" != velocity ]; then
            if [ "$LOADER" = paper ]; then
              MC=$(get https://fill.papermc.io/v3/projects/paper | jq -r '[.versions[][] | select(test("-") | not)][0]')
            else
              MC=$(get "$MOJANG" | jq -r .latest.release)
            fi
          fi
          case "$LOADER" in
          vanilla)
            url=$(get "$MOJANG" | jq -r --arg v "$MC" '.versions[] | select(.id == $v) | .url')
            [ -n "$url" ] || fail "Minecraft has no version $MC"
            server=$(get "$url" | jq -c .downloads.server)
            log "Minecraft $MC"
            fetch "$(jq -r .url <<<"$server")" server.jar sha1 "$(jq -r .sha1 <<<"$server")"
            launch=(-jar server.jar nogui)
            ;;
          fabric)
            lv=$LOADER_VERSION
            if [ -z "$lv" ]; then
              lv=$(get "https://meta.fabricmc.net/v2/versions/loader/$MC" | jq -r '[.[] | select(.loader.stable)][0].loader.version // empty')
            fi
            [ -n "$lv" ] || fail "Fabric has no loader for Minecraft $MC"
            iv=$(get https://meta.fabricmc.net/v2/versions/installer | jq -r '[.[] | select(.stable)][0].version')
            log "Fabric $lv for Minecraft $MC"
            fetch "https://meta.fabricmc.net/v2/versions/loader/$MC/$lv/$iv/server/jar" fabric-server.jar sha1 ""
            launch=(-jar fabric-server.jar nogui)
            ;;
          forge)
            fv=$LOADER_VERSION
            if [ -z "$fv" ]; then
              fv=$(get https://files.minecraftforge.net/net/minecraftforge/forge/promotions_slim.json \
                | jq -r --arg r "$MC-recommended" --arg l "$MC-latest" '.promos[$r] // .promos[$l] // empty')
            fi
            [ -n "$fv" ] || fail "Forge has no version for Minecraft $MC"
            url="https://maven.minecraftforge.net/net/minecraftforge/forge/$MC-$fv/forge-$MC-$fv-installer.jar"
            log "Forge $fv for Minecraft $MC: installing"
            fetch "$url" .seal-mc/installer.jar sha1 "$(mavensha1 "$url")"
            java -jar .seal-mc/installer.jar --installServer > .seal-mc/installer.log 2>&1 \
              || fail "Forge's installer failed; .seal-mc/installer.log says why"
            rm -f .seal-mc/installer.jar
            args="libraries/net/minecraftforge/forge/$MC-$fv/unix_args.txt"
            if [ -f "$args" ]; then
              launch=("@$args" nogui)
            else
              launch=(-jar "$(ls forge-"$MC-$fv"*.jar | grep -v installer | head -n 1)" nogui)
            fi
            ;;
          neoforge)
            nv=$LOADER_VERSION
            if [ -z "$nv" ]; then
              case "$MC" in
                1.*.*) prefix="${MC#1.}." ;;
                1.*) prefix="${MC#1.}.0." ;;
                *.*.*) prefix="$MC." ;;
                *) prefix="$MC.0." ;;
              esac
              nv=$(get https://maven.neoforged.net/api/maven/versions/releases/net/neoforged/neoforge \
                | jq -r --arg p "$prefix" '[.versions[] | select(startswith($p))] | (map(select(test("alpha|beta") | not)) | last) // last // empty')
            fi
            [ -n "$nv" ] || fail "NeoForge has no version for Minecraft $MC"
            url="https://maven.neoforged.net/releases/net/neoforged/neoforge/$nv/neoforge-$nv-installer.jar"
            log "NeoForge $nv for Minecraft $MC: installing"
            fetch "$url" .seal-mc/installer.jar sha1 "$(mavensha1 "$url")"
            java -jar .seal-mc/installer.jar --installServer > .seal-mc/installer.log 2>&1 \
              || fail "NeoForge's installer failed; .seal-mc/installer.log says why"
            rm -f .seal-mc/installer.jar
            launch=("@libraries/net/neoforged/neoforge/$nv/unix_args.txt" nogui)
            ;;
          paper | velocity)
            v=$MC
            build=${LOADER_VERSION:-latest}
            if [ "$LOADER" = velocity ]; then
              v=${LOADER_VERSION:-latest}
              build=latest
              if [ "$v" = latest ]; then
                v=$(get https://fill.papermc.io/v3/projects/velocity | jq -r '[.versions[][] | select(test("SNAPSHOT") | not)][0]')
              fi
            fi
            d=$(get "https://fill.papermc.io/v3/projects/$LOADER/versions/$v/builds/$build" | jq -c '.downloads["server:default"]') \
              || fail "PaperMC has no $LOADER $v, build $build"
            log "$(jq -r .name <<<"$d")"
            fetch "$(jq -r .url <<<"$d")" "$LOADER.jar" sha256 "$(jq -r .checksums.sha256 <<<"$d")"
            launch=(-jar "$LOADER.jar")
            if [ "$LOADER" = paper ]; then launch+=(nogui); fi
            ;;
          esac
          printf '%s\\n' "${launch[@]}" > .seal-mc/launch
          echo "$MC" > .seal-mc/minecraft
          echo "$want" > .seal-mc/requested
        fi
        MC=$(cat .seal-mc/minecraft)

        """;

    static string MOD_SOURCES = """
        # CurseForge's API, with the key: from a file, to stay out of the Nix store, and to curl through a
        # file descriptor, to stay off a command line other users can see.
        CURSEFORGE_API=https://api.curseforge.com/v1
        cfget() { get -H @<(printf 'x-api-key: %s\\n' "$(cat -- "$CURSEFORGE_KEY")") "$CURSEFORGE_API/$1"; }

        # curseforge_site PROJECT FILE: as curseforge below, with no API key, through CurseForge's own site,
        # whose lists of a project's files ask for none. It knows projects only by ID, and gives no hash,
        # so only the file's size is checked, and it can't say whether the author allows this.
        CURSEFORGE_SITE=https://www.curseforge.com/api/v1
        curseforge_site() {
          local project=$1 pin=$2 flavor="" index=0 page here matched="" total file
          case "$LOADER" in
            forge) flavor=1 ;;
            fabric) flavor=4 ;;
            neoforge) flavor=6 ;;
          esac
          case "$pin" in
            "" | *[!0-9]*)
              while :; do
                page=$(get "$CURSEFORGE_SITE/mods/$project/files?pageIndex=$index&pageSize=50&sort=dateCreated&sortDescending=true&gameFlavorId=$flavor") \
                  || fail "CurseForge's site has no project $project, or refused: its ID is on its page, or give an API key"
                here=$(jq -c --arg mc "$MC" '.data[] | select((.gameVersions | index($mc)) and .isEarlyAccessContent != true)' <<<"$page")
                if [ -n "$here" ]; then matched+=$here$'\n'; fi
                total=$(jq -r '.pagination.totalCount // 0' <<<"$page")
                index=$((index + 1))
                if [ $((index * 50)) -ge "$total" ]; then break; fi
                # Newest first: a release is the one to take, a page with none for this version is past
                # them, and a file named is found. It spares a site not meant for this.
                if [ -n "$pin" ]; then
                  if [ -n "$here" ] && jq -se --arg pin "$pin" 'any(.fileName == $pin or .displayName == $pin)' <<<"$here" > /dev/null; then break; fi
                elif [ -z "$here" ]; then
                  if [ -n "$matched" ]; then break; fi
                elif jq -se 'any(.releaseType == 1)' <<<"$here" > /dev/null; then
                  break
                fi
              done
              file=$(jq -sc --arg pin "$pin" '(if $pin != "" then map(select(.fileName == $pin or .displayName == $pin))
                else map(select(.releaseType == 1)) + map(select(.releaseType == 2)) + map(select(.releaseType == 3)) end)
                | .[0] // empty' <<<"$matched")
              ;;
            *)
              file=$(get "$CURSEFORGE_SITE/mods/$project/files/$pin") || fail "CurseForge has no file $pin of $project"
              file=$(jq -c '.data // empty' <<<"$file")
              ;;
          esac
          [ -n "$file" ] || fail "$project has no file${pin:+ $pin} for $LOADER $MC on CurseForge"
          name=$(jq -r .fileName <<<"$file")
          label="$(jq -r .displayName <<<"$file") (no API key: its size alone is checked)"
          url="$CURSEFORGE_SITE/mods/$project/files/$(jq -r .id <<<"$file")/download"
          algo=sha1
          sum=""
          size=$(jq -r '.fileLength // empty' <<<"$file")
        }

        # curseforge PROJECT[@FILE]: the file to take from CurseForge, into sync's name, url, algo, sum and
        # label. Of the files for this loader and Minecraft version, the newest release, or else beta,
        # or else alpha, as CurseForge's site offers; or the one named by its ID, file name or display name.
        curseforge() {
          local project=${1%%@*} pin="" info id type="" index=0 page total all="" file
          if [ "$1" != "$project" ]; then pin=${1#*@}; fi
          slug=$project
          if [ -z "$CURSEFORGE_KEY" ]; then
            curseforge_site "$project" "$pin"
            return
          fi
          [ -r "$CURSEFORGE_KEY" ] || fail "$project is from CurseForge, and there is no API key to read in $CURSEFORGE_KEY"
          local refused="CurseForge didn't answer about $project: is the API key in $CURSEFORGE_KEY right?"
          case "$project" in
            *[!0-9]*)
              info=$(cfget "mods/search?gameId=432&classId=6&slug=$project") || fail "$refused"
              info=$(jq -c --arg s "$project" '[.data[] | select(.slug == $s)][0] // empty' <<<"$info")
              ;;
            *)
              info=$(cfget "mods/$project") || fail "$refused"
              info=$(jq -c '.data // empty' <<<"$info")
              ;;
          esac
          [ -n "$info" ] || fail "CurseForge has no mod $project"
          id=$(jq -r .id <<<"$info")
          case "$LOADER" in
            forge) type=1 ;;
            fabric) type=4 ;;
            neoforge) type=6 ;;
          esac
          case "$pin" in
            "" | *[!0-9]*)
              while :; do
                page=$(cfget "mods/$id/files?gameVersion=$MC&modLoaderType=$type&index=$index&pageSize=50") || fail "$refused"
                all+=$(jq -c '.data[]' <<<"$page")$'\\n'
                total=$(jq -r '.pagination.totalCount // 0' <<<"$page")
                index=$((index + 50))
                if [ "$index" -ge "$total" ] || [ "$index" -ge 9950 ]; then break; fi
              done
              file=$(jq -sc --arg pin "$pin" 'map(select(.isServerPack != true and .isAvailable != false and .isEarlyAccessContent != true))
                | sort_by(.fileDate) | reverse
                | (if $pin != "" then map(select(.fileName == $pin or .displayName == $pin))
                   else map(select(.releaseType == 1)) + map(select(.releaseType == 2)) + map(select(.releaseType == 3)) end)
                | .[0] // empty' <<<"$all")
              ;;
            *)
              file=$(cfget "mods/$id/files/$pin") || fail "CurseForge has no file $pin of $project"
              file=$(jq -c '.data // empty' <<<"$file")
              ;;
          esac
          [ -n "$file" ] || fail "$project has no file${pin:+ $pin} for $LOADER $MC on CurseForge"
          name=$(jq -r .fileName <<<"$file")
          label=$(jq -r .displayName <<<"$file")
          url=$(jq -r '.downloadUrl // empty' <<<"$file")
          [ -n "$url" ] || fail "$project's author doesn't allow downloads through CurseForge's API: so it can't be given here"
          url=${url// /%20}
          algo=sha1
          sum=$(jq -r '[.hashes[]? | select(.algo == 1)][0].value // empty' <<<"$file")
          if [ -z "$sum" ]; then
            algo=md5
            sum=$(jq -r '[.hashes[]? | select(.algo == 2)][0].value // empty' <<<"$file")
          fi
        }

        # modrinth SLUG PIN LOADERS GAMES: the file to take from Modrinth, into sync's name, url, algo, sum
        # and label: the version pinned, or the newest release, or else the newest of any kind, for those
        # loaders and Minecraft versions (GAMES a JSON list, or null for any).
        modrinth() {
          local slug=$1 pin=$2 query versions v file
          query="loaders=$(jq -rn --argjson v "$3" '$v | tojson | @uri')"
          if [ "$4" != null ]; then query="$query&game_versions=$(jq -rn --argjson v "$4" '$v | tojson | @uri')"; fi
          versions=$(get "https://api.modrinth.com/v2/project/$slug/version?$query") || fail "Modrinth has no project $slug"
          v=$(jq -c --arg pin "$pin" '(if $pin != "" then map(select(.version_number == $pin or .id == $pin))
            else map(select(.version_type == "release")) + . end) | .[0] // empty' <<<"$versions")
          [ -n "$v" ] || fail "$slug has no version${pin:+ $pin} for $LOADER $MC on Modrinth"
          file=$(jq -c '(.files | map(select(.primary))) + .files | .[0]' <<<"$v")
          name=$(jq -r .filename <<<"$file")
          url=$(jq -r .url <<<"$file")
          algo=sha512
          sum=$(jq -r .hashes.sha512 <<<"$file")
          label=$(jq -r .version_number <<<"$v")
        }

        # sync DIR LOADERS GAMES SPEC...: the Modrinth projects named, in DIR. A file this put there
        # before, which no project names now, goes; LOADERS and GAMES are JSON lists, or GAMES null.
        # The files chosen are kept, unless autoUpdate, or the loader or Minecraft version they were
        # chosen for has changed: then every project is chosen again.
        sync() {
          local dir=$1 loaders=$2 games=$3
          shift 3
          mkdir -p "$dir"
          local lock=".seal-mc/$dir.lock" next=".seal-mc/$dir.lock.next" made=".seal-mc/$dir.for"
          touch "$lock"
          : > "$next"
          local again=$AUTO_UPDATE
          if [ "$(cat "$made" 2>/dev/null)" != "$LOADER $MC" ]; then again=1; fi
          local spec slug pin old query versions v file name url algo sum label size
          # mods/, when every mod is in the Nix store, is emptied, and filled anew from there, at every start:
          # the mods given, and nothing else. Not plugins/, where plugins keep their own data.
          if [ "$dir" = mods ] && [ "$FROM_NIX" = 1 ]; then
            local whole=1
            for spec in "$@"; do
              name=""
              if [ -n "$DOWNLOADED" ] && [ "$(cat "$DOWNLOADED/.seal-mc/mods.for" 2>/dev/null)" = "$LOADER $MC" ]; then
                name=$(awk -F '\t' -v s="$spec" '$1 == s { print $2 }' "$DOWNLOADED/.seal-mc/mods.lock" 2>/dev/null || true)
              fi
              if [ -z "$name" ] || [ ! -f "$DOWNLOADED/mods/$name" ]; then whole=0; fi
            done
            if [ "$whole" = 1 ]; then
              rm -rf -- mods
              mkdir mods
              : > "$lock"
            fi
          fi
          for spec in "$@"; do
            slug=${spec%%@*}
            pin=
            if [ "$spec" != "$slug" ]; then pin=${spec#*@}; fi
            old=$(awk -F '\\t' -v s="$spec" '$1 == s { print $2 }' "$lock")
            # What Nix downloaded, by minecraft.lock, is copied in, with no need of the network.
            if [ -n "$DOWNLOADED" ] && [ "$(cat "$DOWNLOADED/.seal-mc/$dir.for" 2>/dev/null)" = "$LOADER $MC" ]; then
              name=$(awk -F '\\t' -v s="$spec" '$1 == s { print $2 }' "$DOWNLOADED/.seal-mc/$dir.lock" 2>/dev/null || true)
              if [ -n "$name" ] && [ -f "$DOWNLOADED/$dir/$name" ]; then
                if [ ! -f "$dir/$name" ]; then
                  cp -f -- "$DOWNLOADED/$dir/$name" "$dir/$name.part"
                  chmod 644 "$dir/$name.part"
                  mv -f "$dir/$name.part" "$dir/$name"
                  log "$dir: $name, as Nix downloaded it"
                fi
                if [ -n "$old" ] && [ "$old" != "$name" ]; then rm -f "$dir/$old"; fi
                printf '%s\\t%s\\n' "$spec" "$name" >> "$next"
                continue
              fi
            fi
            if [ "$again" != 1 ] && [ -n "$old" ] && [ -f "$dir/$old" ]; then
              printf '%s\\t%s\\n' "$spec" "$old" >> "$next"
              continue
            fi
            size=""
            if [ "$spec" != "${spec#curseforge:}" ]; then
              curseforge "${spec#curseforge:}"
            else
              modrinth "$slug" "$pin" "$loaders" "$games"
            fi
            case "$name" in */* | . | ..) fail "$slug's file has no usable name: $name" ;; esac
            if [ ! -f "$dir/$name" ]; then
              log "$dir: $slug $label"
              fetch "$url" "$dir/$name" "$algo" "$sum" "$size"
            fi
            if [ -n "$old" ] && [ "$old" != "$name" ]; then rm -f "$dir/$old"; fi
            printf '%s\\t%s\\n' "$spec" "$name" >> "$next"
          done
          while IFS=$'\\t' read -r spec old; do
            if ! awk -F '\\t' -v f="$old" '$2 == f { found = 1 } END { exit !found }' "$next"; then
              rm -f "$dir/$old"
              log "$dir: removed $old"
            fi
          done < "$lock"
          mv -f "$next" "$lock"
          echo "$LOADER $MC" > "$made"
        }

        """;

    // Where minecraft.lock is: beside the Seal configuration, as a path in the Nix store, for the wrapper to find in
    // the flake.
    static string LOCK_FILE = """
        toString ((if builtins.readFileType config.seal-nix.src == "directory" then config.seal-nix.src
          else dirOf config.seal-nix.src) + "/minecraft.lock")
        """;

    // A server's mods and plugins as minecraft.lock has them, each downloaded by Nix by its sha512, in a folder
    // as sync reads it: mods/ and plugins/, and .seal-mc's lock and for. What the lock doesn't have (yet) is
    // left to the start, with a warning; a lock for another loader or Minecraft version has nothing.
    static string DOWNLOADS = """
        name:
        let
          src = config.seal-nix.src;
          file = (if builtins.readFileType src == "directory" then src else dirOf src) + "/minecraft.lock";
          lock = if builtins.pathExists file then builtins.fromJSON (builtins.readFile file) else { };
          want = builtins.fromJSON config.system.build.minecraftRequests."minecraft-${name}";
          got = lock.servers.${name} or { };
          same = (got.loader or null) == want.loader && (got.minecraft or null) == want.minecraft;
          entry = kind: spec: if same then got.${kind}.${spec} or null else null;
          missing = lib.filter (spec: entry "mods" spec == null) want.mods
            ++ lib.filter (spec: entry "plugins" spec == null) want.plugins;
          links = kind: lib.concatMapStrings (spec: let e = entry kind spec; in lib.optionalString (e != null) ''
            ln -s ${pkgs.fetchurl { name = "minecraft-file"; inherit (e) url sha512; }} "$out"/${kind}/${lib.escapeShellArg e.file}
            printf '%s\\t%s\\n' ${lib.escapeShellArg spec} ${lib.escapeShellArg e.file} >> "$out"/.seal-mc/${kind}.lock
          '') want.${kind};
          made = lib.escapeShellArg "${want.loader} ${want.minecraft}";
          warned = if missing == [ ] then (x: x)
            else lib.warn ("minecraft ${name}: its start will download ${lib.concatStringsSep ", " missing}, which "
              + "minecraft.lock doesn't have yet; this library's nixos-rebuild writes it, from the rebuild after the one that installs it");
        in
        warned (pkgs.runCommandLocal "minecraft-${name}-downloads" { } (''
          mkdir -p "$out"/mods "$out"/plugins "$out"/.seal-mc
          touch "$out"/.seal-mc/mods.lock "$out"/.seal-mc/plugins.lock
          echo ${made} > "$out"/.seal-mc/mods.for
          echo ${made} > "$out"/.seal-mc/plugins.for
        '' + links "mods" + links "plugins"))
        """;

    // This library's nixos-rebuild, before NixOS's own (REAL), which it runs after with the same arguments: from
    // a local flake's configuration, minecraft.lock. It runs TOOLS, MOD_SOURCES and LOCKING after this.
    static string REBUILD = """
        set -euo pipefail
        action="" flake="" rollback=0
        args=("$@")
        for ((k = 0; k < ${#args[@]}; k++)); do
          case "${args[k]}" in
            switch | boot | test | build | dry-build | dry-activate | build-vm | build-vm-with-bootloader | build-image)
              if [ -z "$action" ]; then action=${args[k]}; fi ;;
            --rollback) rollback=1 ;;
            --flake) flake=${args[k + 1]:-} ;;
            --flake=*) flake=${args[k]#--flake=} ;;
            --no-flake) flake=- ;;
          esac
        done
        if [ -z "$action" ] || [ "$rollback" = 1 ] || [ "$flake" = - ]; then exec "$REAL" "$@"; fi
        if [ -z "$flake" ]; then
          if [ ! -e /etc/nixos/flake.nix ]; then exec "$REAL" "$@"; fi
          flake=$(dirname -- "$(readlink -f /etc/nixos/flake.nix)")
        fi
        host=$(cat /proc/sys/kernel/hostname)
        case "$flake" in *'#'*) host=${flake#*#}; flake=${flake%%#*} ;; esac
        dir=${flake#path:}
        dir=${dir#git+file://}
        # A flake elsewhere, on GitHub say, has its minecraft.lock as it is.
        if [ ! -f "$dir/flake.nix" ]; then exec "$REAL" "$@"; fi
        dir=$(cd -- "$dir" && pwd)
        # The flake's owner's, for git, which won't work in another's repository, and for minecraft.lock.
        owner=$(stat -c %U "$dir")
        as() { if [ "$(id -u)" = 0 ] && [ "$owner" != root ]; then runuser -u "$owner" -- "$@"; else "$@"; fi; }
        evaluate() { nix --extra-experimental-features 'nix-command flakes' "$@" 2>/dev/null; }
        at="$dir#nixosConfigurations.\\"$host\\".config.system.build"
        # A configuration that doesn't build, or has no servers that need minecraft.lock, goes to the real one.
        requests=$(evaluate eval --json "$at.minecraftRequests") || exec "$REAL" "$@"
        stored=$(evaluate eval --raw "$at.minecraftLockFile") || exec "$REAL" "$@"
        root=$(evaluate flake metadata --json "$dir" | jq -r .path) || exec "$REAL" "$@"
        rel=${stored#"$root"/}
        if [ "$rel" = "$stored" ]; then
          echo "minecraft: $stored isn't in $dir's flake, so it stays as it is" >&2
          exec "$REAL" "$@"
        fi
        top=$dir
        if as git -C "$dir" rev-parse --show-toplevel > /dev/null 2>&1; then top=$(as git -C "$dir" rev-parse --show-toplevel); fi
        LOCKFILE=$top/$rel
        here=$PWD
        work=$(mktemp -d)
        trap 'rm -rf "$work"' EXIT
        cd "$work"
        """;

    // minecraft.lock: for each server, its loader and Minecraft version, and for each mod and plugin its file,
    // where Nix downloads it, and its sha512. A mod the configuration no longer names goes, one it names stays
    // as it is, and a new one is chosen, as a start would; a server whose loader or version changed has every
    // one chosen again. One that can't be had stops the rebuild here, before Nix is asked anything.
    static string LOCKING = """
        old='{}'
        if [ -s "$LOCKFILE" ]; then old=$(jq -c . "$LOCKFILE") || fail "$LOCKFILE can't be read: mend it, or delete it"; fi
        new='{"servers":{}}'
        while IFS= read -r one; do
          NAME=$(jq -r .name <<<"$one")
          LOADER=$(jq -r .want.loader <<<"$one")
          MC=$(jq -r .want.minecraft <<<"$one")
          CURSEFORGE_KEY=$(jq -r .want.curseforgeKey <<<"$one")
          log() { echo "minecraft $NAME: $*" >&2; }
          was=$(jq -c --arg n "$NAME" '.servers[$n] // {}' <<<"$old")
          again=0
          if [ "$(jq -r '"\\(.loader) \\(.minecraft)"' <<<"$was")" != "$LOADER $MC" ]; then again=1; fi
          entry=$(jq -cn --arg l "$LOADER" --arg m "$MC" '{loader: $l, minecraft: $m, mods: {}, plugins: {}}')
          games=$(jq -cn --arg v "$MC" '[$v]')
          for kind in mods plugins; do
            case "$LOADER:$kind" in
              fabric:mods | forge:mods | neoforge:mods) loaders=$(jq -cn --arg l "$LOADER" '[$l]'); versions=$games ;;
              paper:plugins) loaders='["paper","spigot","bukkit"]'; versions=$games ;;
              velocity:plugins) loaders='["velocity"]'; versions=null ;;
              *) continue ;;
            esac
            while IFS= read -r spec; do
              kept=$(jq -c --arg k "$kind" --arg s "$spec" '.[$k][$s] // empty' <<<"$was")
              if [ "$again" = 0 ] && [ -n "$kept" ]; then
                entry=$(jq -c --arg k "$kind" --arg s "$spec" --argjson e "$kept" '.[$k][$s] = $e' <<<"$entry")
                continue
              fi
              slug=${spec%%@*}
              pin=
              if [ "$spec" != "$slug" ]; then pin=${spec#*@}; fi
              size=""
              if [ "$spec" != "${spec#curseforge:}" ]; then
                # A key a secrets manager puts in place later in this first rebuild: the start downloads this one.
                if [ -n "$CURSEFORGE_KEY" ] && [ ! -r "$CURSEFORGE_KEY" ]; then
                  log "${slug#curseforge:}: no API key to read in $CURSEFORGE_KEY yet, so the server's start will download it"
                  continue
                fi
                curseforge "${spec#curseforge:}"
              else
                modrinth "$slug" "$pin" "$loaders" "$versions"
              fi
              case "$name" in "" | */* | . | .. | *$'\\t'* | *$'\\n'*) fail "$slug's file has no usable name: $name" ;; esac
              # CurseForge gives a sha1 or md5, or nothing: the file, once, checked as a start would, for its
              # sha512, and for the address it comes from, past CurseForge's site.
              if [ "$algo" != sha512 ] || [ -z "$sum" ]; then
                rm -f file
                url=$(get -o file -w '%{url_effective}' "$url") || fail "can't download $url"
                if [ -n "$sum" ] && [ "$("${algo}sum" file | cut -d ' ' -f 1)" != "$sum" ]; then fail "$url: the download's $algo isn't $sum"; fi
                if [ -n "$size" ] && [ "$(stat -c %s file)" != "$size" ]; then fail "$url: the download isn't the $size bytes it should be"; fi
                sum=$(sha512sum file | cut -d ' ' -f 1)
              fi
              log "$kind: $slug $label"
              entry=$(jq -c --arg k "$kind" --arg s "$spec" --arg f "$name" --arg u "$url" --arg h "$sum" \\
                '.[$k][$s] = {file: $f, url: $u, sha512: $h}' <<<"$entry")
            done < <(jq -r --arg k "$kind" '.want[$k][]' <<<"$one")
          done
          new=$(jq -c --arg n "$NAME" --argjson e "$entry" '.servers[$n] = $e' <<<"$new")
        done < <(jq -c 'to_entries[] | {name: (.key | ltrimstr("minecraft-")), want: (.value | fromjson)}' <<<"$requests")
        jq -S . <<<"$new" > lock
        if [ ! -f "$LOCKFILE" ] || ! cmp -s lock "$LOCKFILE"; then
          cp lock "$LOCKFILE.next"
          mv -f "$LOCKFILE.next" "$LOCKFILE"
          if [ "$(id -u)" = 0 ]; then chown "$owner:$(stat -c %G "$dir")" "$LOCKFILE"; fi
          echo "minecraft: wrote $LOCKFILE" >&2
        fi
        # A flake sees only the files git knows of.
        if [ "$top" != "$dir" ] || as git -C "$dir" rev-parse > /dev/null 2>&1; then
          if ! as git -C "$top" ls-files --error-unmatch -- "$rel" > /dev/null 2>&1; then
            as git -C "$top" add --intent-to-add -- "$rel"
          fi
        fi
        cd "$here"
        rm -rf "$work"
        trap - EXIT
        exec "$REAL" "$@"
        """;

    static string SYNC_ALL = """
        games=$(jq -cn --arg v "$MC" '[$v]')
        case "$LOADER" in
          fabric | forge | neoforge) sync mods "$(jq -cn --arg l "$LOADER" '[$l]')" "$games" "${MODS[@]}" ;;
          paper) sync plugins '["paper","spigot","bukkit"]' "$games" "${PLUGINS[@]}" ;;
          velocity) sync plugins '["velocity"]' null "${PLUGINS[@]}" ;;
        esac

        """;

    static string SETTINGS = """
        # The port, and what else the configuration sets. For Velocity, velocity.toml: its bind, its
        # forwarding, and, when the configuration names servers, its [servers] and [forced-hosts].
        if [ "$LOADER" = velocity ]; then
          if [ "$OWN_SECRET" = 1 ] && [ ! -s "$SECRET" ]; then
            secret=$(head -c 32 /dev/urandom | sha256sum | cut -d ' ' -f 1)
            (umask 077 && printf '%s' "$secret" > "$SECRET.part")
            mv -f "$SECRET.part" "$SECRET"
            log "a new forwarding secret, in $SECRET"
          fi
          case "$FORWARDING" in
            MODERN | BUNGEEGUARD)
              [ -r "$SECRET" ] && [ -s "$SECRET" ] || fail "$FORWARDING forwarding is signed with a secret, and $SECRET holds none" ;;
          esac
          # A new velocity.toml is Velocity's own, with its config-version: without one, Velocity takes the
          # file for an old one, and puts forwarding-secret-file back to forwarding.secret.
          if [ ! -s velocity.toml ]; then
            unzip -p velocity.jar default-velocity.toml > velocity.toml.next 2>/dev/null || true
            [ -s velocity.toml.next ] || echo 'config-version = "2.0"' > velocity.toml.next
            mv -f velocity.toml.next velocity.toml
          fi
          TOP=$(printf '%s\\n' "bind = '0.0.0.0:$PORT'" "player-info-forwarding-mode = '$FORWARDING'" \
            "forwarding-secret-file = '$SECRET'")
          # TOP's keys, each in place of the one there, or else before the first table; TABLES, when there
          # are any, in place of [servers] and [forced-hosts], keeping the comments of the table after them.
          TOP=$TOP TABLES=$SERVERS awk '
            BEGIN {
              n = split(ENVIRON["TOP"], top, "\\n")
              for (i = 1; i <= n; i++) { k = top[i]; sub(/[[:blank:]]*=.*/, "", k); want[k] = i }
              tables = ENVIRON["TABLES"]
            }
            function rest(  i) { for (i = 1; i <= n; i++) if (!(i in done)) print top[i]; intables = 1 }
            /^[[:blank:]]*[[][^]]*[]][[:blank:]]*(#.*)?$/ {
              if (!intables) rest()
              name = $0; sub(/^[[:blank:]]*[[][[:blank:]]*"?/, "", name); sub(/"?[[:blank:]]*[]].*/, "", name)
              if (tables != "" && (name == "servers" || name == "forced-hosts")) {
                if (!put) { printf "%s", tables; put = 1 }
                skip = 1; held = ""; next
              }
              if (skip) { printf "%s", held; skip = 0 }
              print; next
            }
            skip {
              if ($0 ~ /^[[:blank:]]*(#.*)?$/) held = held $0 "\\n"; else held = ""
              next
            }
            !intables && /^[[:blank:]]*[A-Za-z0-9_-]+[[:blank:]]*=/ {
              k = $0; sub(/^[[:blank:]]*/, "", k); sub(/[[:blank:]]*=.*/, "", k)
              if (k in want) { if (!(want[k] in done)) print top[want[k]]; done[want[k]] = 1; next }
            }
            { print }
            END {
              if (!intables) rest()
              if (skip) printf "%s", held
              if (tables != "" && !put) { print ""; printf "%s", tables }
            }' velocity.toml > velocity.toml.next
          mv -f velocity.toml.next velocity.toml
        else
          if [ "$EULA" = 1 ]; then echo eula=true > eula.txt; fi
          # Behind a proxy, the folder is the user minecraft's alone, as StateDirectoryMode makes a new
          # one: Paper keeps the proxy's secret in config/paper-global.yml.
          if [ -n "$BEHIND" ]; then chmod 750 .; fi
          # Out from behind a proxy: online again, on every address.
          was=$(cat .seal-mc/behind 2>/dev/null || true)
          if [ -z "$BEHIND" ] && [ -n "$was" ]; then PROPERTIES=(online-mode=true server-ip= "${PROPERTIES[@]}"); fi
          touch server.properties
          for kv in "server-port=$PORT" "${PROPERTIES[@]}"; do
            KV=$kv awk 'BEGIN { kv = ENVIRON["KV"]; k = substr(kv, 1, index(kv, "=")) }
              index($0, k) == 1 { if (!done) print kv; done = 1; next }
              { print }
              END { if (!done) print kv }' server.properties > server.properties.next
            mv -f server.properties.next server.properties
          done
          # Paper takes a proxy's forwarding in config/paper-global.yml (modern, whose secret comes as it
          # starts, in PAPER_VELOCITY_SECRET) or spigot.yml (legacy), and leaves it when out from behind.
          if [ "$LOADER" = paper ] && { [ -n "$BEHIND" ] || [ -n "$was" ]; }; then
            mkdir -p config
            touch config/paper-global.yml spigot.yml
            modern=false
            legacy=false
            if [ "$BEHIND" = MODERN ]; then modern=true; fi
            if [ "$BEHIND" = LEGACY ]; then legacy=true; fi
            MODERN=$modern yq -i '.proxies.velocity.enabled = env(MODERN) | .proxies.velocity["online-mode"] = true
              | .proxies["bungee-cord"]["online-mode"] = true' config/paper-global.yml
            LEGACY=$legacy yq -i '.settings.bungeecord = env(LEGACY)' spigot.yml
          fi
          echo "$BEHIND" > .seal-mc/behind
        fi

        yqv() { yq --version 2>/dev/null | grep -o 'v[0-9][0-9.]*' | head -1; }

        # edit FILE FORMAT EXPRESSION: yq's EXPRESSION on a config file, into FILE.next, read as AS. JSON5
        # is read by Python, and comes out as plain JSON, which is JSON5 too. FILE.next is read again, and
        # must hold what yq meant: yq before 4.54 writes a key new to a TOML table after that table's
        # sections, so that it is read as the last section's. Then each table's values go before its
        # sections, as TOML has them, and it is written again. 2 if yq still writes it wrong.
        edit() {
          local file=$1 format=$2 expression=$3 input=$1 meant
          local order='(.. | select(tag == "!!map")) |= (to_entries
            | sort_by(.value | tag == "!!map" or (tag == "!!seq" and length > 0 and all_c(tag == "!!map"))) | from_entries)'
          AS=$format
          if [ "$format" = json5 ]; then
            AS=json
            input=$file.read
            if [ ! -s "$file" ]; then
              echo '{}' > "$input"
            elif command -v python3 > /dev/null; then
              python3 -I -c 'import json, json5, sys; json.dump(json5.load(open(sys.argv[1], encoding="utf-8")), sys.stdout)' \
                "$file" > "$input" || return 1
            else
              cp "$file" "$input"
            fi
          fi
          yq -p "$AS" -o "$AS" "$expression" "$input" > "$file.next" || return 1
          meant=$(yq -p "$AS" -o json "$expression" "$input" | jq -S .) || return 1
          if [ "$(yq -p "$AS" -o json "$file.next" 2>/dev/null | jq -S . 2>/dev/null)" != "$meant" ]; then
            yq -p "$AS" -o "$AS" "$expression | $order" "$input" > "$file.next" || return 2
            [ "$(yq -p "$AS" -o json "$file.next" 2>/dev/null | jq -S . 2>/dev/null)" = "$meant" ] || return 2
          fi
        }

        # property FILE KEY [VALUE]: KEY's line in a .properties file, in place of the one there, or
        # added; without a VALUE, no such line.
        property() {
          local given=$#
          KEY=$2 VALUE=${3-} GIVEN=$given awk 'BEGIN { k = ENVIRON["KEY"]; line = k "=" ENVIRON["VALUE"]; put = ENVIRON["GIVEN"] == 3 }
            function same(t) {
              sub(/^[[:blank:]]+/, "", t)
              if (index(t, k) != 1) return 0
              t = substr(t, length(k) + 1)
              return t == "" || t ~ /^[[:blank:]=:]/
            }
            same($0) { if (put && !done) print line; done = 1; next }
            { print }
            END { if (put && !done) print line }' "$1" > "$1.next"
          mv -f "$1.next" "$1"
        }

        # The config files: first what an earlier start set, which the configuration no longer does, goes,
        # a key so that the mod is back to its default, a whole file with its text().
        printf '%s' "$CONFIGS" > .seal-mc/configs.next
        if [ -s .seal-mc/configs ]; then
          while IFS= read -r gone; do
            file=$(jq -r .path <<<"$gone")
            if [ "$(jq -r .whole <<<"$gone")" = true ]; then
              rm -f "$file"
              log "config: removed $file"
            elif [ -f "$file" ]; then
              format=$(jq -r .format <<<"$gone")
              if [ "$format" = properties ]; then
                while IFS= read -r key; do property "$file" "$key"; done < <(jq -r '.keys[][0]' <<<"$gone")
                log "config: $file: took out what is no longer set"
              else
                status=0
                KEYS=$(jq -c .keys <<<"$gone") edit "$file" "$format" 'delpaths(env(KEYS))' || status=$?
                if [ "$status" = 0 ]; then
                  mv -f "$file.next" "$file"
                  log "config: $file: took out what is no longer set"
                elif [ "$status" = 2 ]; then
                  log "config: $file: yq $(yqv) writes it wrong without them, so what is no longer set stays in it"
                else
                  log "config: $file: can't be read, so what is no longer set stays in it"
                fi
              fi
              rm -f "$file.next" "$file.read"
            fi
          done < <(jq -c --slurpfile now .seal-mc/configs.next '.[] | . as $o | ($now[0] | map(select(.path == $o.path)) | .[0]) as $n
            | if $n == null then (if $o.text != null then {path: $o.path, whole: true} else {path: $o.path, format: $o.format, keys: [$o.set[].key]} end)
              elif $n.text != null or $o.text != null then empty
              else {path: $o.path, format: $o.format, keys: ([$o.set[].key] - [$n.set[].key])} | select(.keys != []) end' .seal-mc/configs)
        fi

        # Then what the configuration gives, last, so that it has the last word on any file.
        while IFS= read -r config; do
          file=$(jq -r .path <<<"$config")
          format=$(jq -r .format <<<"$config")
          settings=$(jq -c .set <<<"$config")
          mkdir -p "$(dirname -- "$file")"
          if [ "$(jq -r '.text != null' <<<"$config")" = true ]; then
            jq -j .text <<<"$config" > "$file.next"
            mv -f "$file.next" "$file"
          elif [ "$format" = properties ]; then
            touch "$file"
            while IFS=$'\\t' read -r key value; do
              property "$file" "$key" "$value"
            done < <(jq -r '.[] | .key[0] + "\\t" + .value' <<<"$settings")
          else
            touch "$file"
            status=0
            SET=$settings edit "$file" "$format" 'env(SET)[] as $e ireduce (.; setpath($e.key; $e.value))' || status=$?
            if [ "$status" != 0 ]; then rm -f "$file.next" "$file.read"; fi
            if [ "$status" = 2 ]; then
              fail "$file: yq $(yqv) writes it wrong with its settings, so it is left as it was: a newer nixpkgs has a newer yq"
            elif [ "$status" != 0 ] && [ "$format" = toml ] && ! printf '[a]\\nb = 1\\n' | yq -p toml -o toml . > /dev/null 2>&1; then
              fail "yq $(yqv) can't write TOML, so $file's settings can't be set: that takes yq 4.52 or newer, from a newer nixpkgs"
            elif [ "$status" != 0 ]; then
              fail "$file can't be read as $format, so its settings can't be set; text() writes a whole file"
            fi
            # A key under what isn't a section isn't set, and yq doesn't say so.
            missed=$(yq -p "$AS" -o json "$file.next" | jq -r --argjson s "$settings" \
              '. as $d | $s[] as $e | select((try ($d | getpath($e.key)) catch null) != $e.value) | $e.key | join(".")')
            if [ -n "$missed" ]; then
              rm -f "$file.next" "$file.read"
              fail "$file: can't set $missed, which is under a value that isn't a section"
            fi
            mv -f "$file.next" "$file"
            rm -f "$file.read"
          fi
        done < <(jq -c '.[]' <<<"$CONFIGS")
        mv -f .seal-mc/configs.next .seal-mc/configs

        # players FILE STATE NAMED DEFAULTS: ops.json, banned-players.json or whitelist.json, if the
        # configuration names anyone, or did. Each player it names is set, one it named and no longer does goes, and those the
        # server added stay. An entry already there keeps what NAMED doesn't say, and a new one has DEFAULTS.
        # A broken file stops the start, whose reason is then in the log: Paper would set it aside and
        # start with an empty list, and let a banned player in.
        players() {
          local file=$1 state=.seal-mc/$2 named=$3 defaults=$4 was='[]'
          if [ -s "$state" ]; then was=$(cat "$state"); fi
          if [ "$named" = '[]' ] && [ "$was" = '[]' ]; then return 0; fi
          if [ ! -s "$file" ]; then echo '[]' > "$file"; fi
          jq --argjson named "$named" --argjson was "$was" --argjson defaults "$defaults" '
            def id: (.uuid // "") | ascii_downcase;
            if type != "array" then error("not a list") else . end
            | . as $old
            | map(select(id | IN($named[].uuid, $was[]) | not))
              + [$named[] | . as $n | $defaults + ([$old[] | select(id == $n.uuid)][0] // {}) + $n]' "$file" > "$file.next" \\
            || { rm -f "$file.next"; fail "$file can't be read as a list of players, so its players can't be set: mend it, or delete it"; }
          mv -f "$file.next" "$file"
          jq -c 'map(.uuid)' <<<"$named" > "$state"
        }

        # Last, so that a config file given whole for one of these can't undo them.
        players ops.json ops "$OPS" '{"bypassesPlayerLimit":false}'
        now=$(date '+%Y-%m-%d %H:%M:%S %z')
        players banned-players.json bans "$BANS" "$(jq -cn --arg now "$now" '{created: $now, source: "Server", reason: "Banned by an operator."}')"
        players whitelist.json whitelist "$WHITELIST" '{}'
        """;
}
