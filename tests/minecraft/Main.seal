import sealnix.*;
import sealnix.libs.minecraft.*;

// The minecraft library's servers: one on its own, and a Velocity proxy with two servers configured
// here behind it, and one elsewhere, by its address.
class Main {
    static void main() {
        Server.setCurseForgeKeyFile("/run/secrets/curseforge");

        new Server("survival")
            .loader(Loader.FABRIC)
            .minecraftVersion("26.3")
            .acceptEula()
            .memory("4G")
            .modrinthMod("fabric-api")
            .modrinthMod("lithium", "mc26.3-0.26.3-fabric")          // a version, by its version number
            .curseforgeMod("appleskin")                              // from CurseForge
            .curseforgeMod("jei", "jei-26.3-fabric-31.17.0.109.jar")  // a file of it, by its name
            .property("motd", "A Seal server")
            .config(new ConfigFile("config/mymod.toml").set("general.threads", 4).set("general.fastMath", true))
            .config(new ConfigFile("config/other.json5").set("a\\.b.c", "x"))
            .config(new ConfigFile("config/lithium.properties").set("mixin.ai.pathing", false))
            .config(new ConfigFile("config/whole.conf").text("hello\n"))
            .op("seal", "11111111-2222-4333-8444-555555555555", 4)
            .op("mod", "AAAAAAAABBBB4CCC8DDDEEEEEEEEEEEE", 2)        // Mojang's form: no dashes, and any case
            .ban("griefer", "99999999-8888-4777-8666-555555555555")
            .whitelist("seal", "11111111-2222-4333-8444-555555555555")   // an operator can be on it too
            .whitelist("friend", "BBBBBBBBCCCC4DDD8EEEFFFFFFFFFFFF")
            .install();

        new Server("fresh").loader(Loader.FABRIC).minecraftVersion("latest").acceptEula().port(25572)
            .openFirewall(false).modrinthMod("lithium").install();    // its version is chosen at its start, and so its mods

        var lobby = new Server("lobby").loader(Loader.PAPER).minecraftVersion("26.3")
            .acceptEula().port(25566).plugin("luckperms", "v5.5.71-bukkit")
            .config(new ConfigFile("plugins/LuckPerms/config.yml").set("server", "lobby"));
        var smp = new Server("smp").loader(Loader.FABRIC).minecraftVersion("26.3")
            .acceptEula().modrinthMod("lithium");
        smp.port(25567);                                     // a server given to the proxy can still change
        var hub = new Server("hub-server").loader(Loader.PAPER).minecraftVersion("26.3").acceptEula().port(25568);
        var neo = new Server("neo").loader(Loader.NEOFORGE).minecraftVersion("1.21.11").acceptEula().port(25569)
            .modrinthMod("CFX9ftUJ")                         // by its project ID
            .modrinthMod("RT18TcxA", "1.2.5")                // NeoVelocity itself, by its ID, so it isn't added again
            .config(new ConfigFile("config/neovelocity-common.toml").set("compatibility.login-custom-packet-catchall", false));
        var plain = new Server("neo-plain").loader(Loader.NEOFORGE).minecraftVersion("1.21.11").acceptEula().port(25571);

        new Proxy("proxy")
            .server(lobby)
            .server(smp)
            .server(hub, "hub")                              // under another name on the proxy
            .server(neo)
            .server(plain)
            .server("creative", "10.0.0.5:25565")
            .tryServer("lobby")
            .tryServer("smp")
            .forcedHost("smp.example.com", "smp")
            .forcedHost("hub.example.com", "hub")
            .plugin("luckperms")
            .install();
    }
}
