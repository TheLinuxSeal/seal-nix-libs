import sealnix.*;
import sealnix.libs.minecraft.*;

// The minecraft library's servers: one on its own, and a Velocity proxy with two servers configured
// here behind it, and one elsewhere, by its address.
class Main {
    static void main() {
        new Server("survival")
            .loader(Loader.FABRIC)
            .minecraftVersion("26.3")
            .acceptEula()
            .memory("4G")
            .mod("fabric-api")
            .mod("lithium", "mc26.3-0.26.3-fabric")          // a version, by its version number
            .property("motd", "A Seal server")
            .config(new ConfigFile("config/mymod.toml").set("general.threads", 4).set("general.fastMath", true))
            .config(new ConfigFile("config/other.json5").set("a\\.b.c", "x"))
            .config(new ConfigFile("config/lithium.properties").set("mixin.ai.pathing", false))
            .config(new ConfigFile("config/whole.conf").text("hello\n"))
            .install();

        var lobby = new Server("lobby").loader(Loader.PAPER).minecraftVersion("26.3")
            .acceptEula().port(25566).plugin("luckperms", "v5.5.71-bukkit")
            .config(new ConfigFile("plugins/LuckPerms/config.yml").set("server", "lobby"));
        var smp = new Server("smp").loader(Loader.FABRIC).minecraftVersion("26.3")
            .acceptEula().mod("lithium");
        smp.port(25567);                                     // a server given to the proxy can still change

        new Proxy("proxy")
            .server(lobby)
            .server(smp)
            .server("creative", "10.0.0.5:25565")
            .tryServer("lobby")
            .tryServer("smp")
            .forcedHost("smp.example.com", "smp")
            .plugin("luckperms")
            .install();
    }
}
